#!/usr/bin/env bash
# preflight-checks — every deterministic checkpoint of the current branch in one
# call, plus the facts kix:preflight reads before its checks (kxa-cx0). No LLM,
# no network beyond a cached fetch: fast enough for a Stop hook (kxa-v9v).
# Each checkpoint is its own cp_* function so the check library (kxa-102) and
# the gate runner (kxa-efc) can name and reuse them.

set -uo pipefail

usage() {
  cat <<'EOF'
Usage: preflight-checks [--format pretty|tsv] [--no-fetch] [--session ID]
       preflight-checks start [--session ID]
       preflight-checks mark <check> [--bead ID] [--session ID]   (JSON on stdin)
       preflight-checks resolve <id> fixed|deferred <ref>|discarded <reason...>
       preflight-checks findings [<check>]

Prints one row per fact, then one per checkpoint. --format pretty (the
default) prints them as an aligned Markdown table:

  | name    | status | detail      |
  | ------- | ------ | ----------- |
  | default | fact   | origin/main |

--format tsv prints the same rows as bare tab-separated lines, no header —
for scripts.

Facts (status "fact"):
  default    the default branch's remote ref (origin/main), or "-"
  from       the commit diff-review's marker covers, when it is an ancestor of
             HEAD, else "-"
  shortstat  git diff --shortstat from the merge base to HEAD
  markdown   Markdown files the branch or the dirty tree touches, ", "-joined
  fetch      fresh | fetched | failed | skipped

Checkpoints (status pass | finding | fresh | stale | unknown | never | skip):
  uncommitted-changes    uncommitted changes
  unlanded-commits       commits in HEAD that are not on the default branch
  behind-default-branch  the default branch is not an ancestor of HEAD
  open-checkboxes ...    one row per markable check (see `mark`): fresh when
                         its marker exists and nothing it saw changed, stale
                         with the reasons, never with no marker, skip when
                         there is nothing to check. open-checkboxes adds the
                         unchecked "- [ ]" lines as file:line.
  findings-leftovers     findings recorded with `mark` and still open

Subcommands (the session store, kxa-102; JSON lines under
<git common dir>/kix/checks/<session>/, append-only, read per branch):
  start     record a run anchor and print it
  mark      record that <check> ran; stdin is a JSON array of new findings
            (category, summary, optional file, line, short_summary,
            failure_scenario, ref); prints their new ids
  resolve   close a finding: fixed, deferred <ref> or discarded <reason...>
  findings  print the open findings of this branch as one JSON array
  bd-mark start|review
            record the beads DB's dolt commit in bd.jsonl (kxa-a9i): start
            once per session (the SessionStart hook), review each time the
            user has seen the bead changes; a no-op without a beads DB

  --bead ID     with mark acceptance-criteria: the bead whose updates stale it

  --no-fetch    never fetch; the default fetches origin only when the last
                fetch is older than KIX_FETCH_TTL minutes (default 5)
  --session ID  the session whose store is used (default
                $CLAUDE_CODE_SESSION_ID, else "unknown")

Exit 1 outside a git work tree, 0 otherwise — findings are output, not errors.
EOF
}

fetch=1
# The default lives here so it can become configurable later.
format=pretty
session=${CLAUDE_CODE_SESSION_ID-}
bead=""
dolt_json=""
sub=""
pos=()
case ${1-} in
start | mark | resolve | findings | bd-mark | diff)
  sub=$1
  shift
  ;;
esac
while [ $# -gt 0 ]; do
  # After resolve's outcome word everything is the reason or ref, literally.
  if [ "$sub" = resolve ] && [ ${#pos[@]} -ge 2 ]; then
    pos+=("$1")
    shift
    continue
  fi
  case $1 in
  --no-fetch) fetch=0 ;;
  --format)
    format=${2-}
    shift
    ;;
  --format=*) format=${1#--format=} ;;
  --session)
    session=${2-}
    shift
    ;;
  --bead)
    bead=${2-}
    shift
    ;;
  --dolt-json)
    dolt_json=${2-}
    shift
    ;;
  -h | --help) usage && exit 0 ;;
  -*) usage >&2 && exit 1 ;;
  *)
    [ -n "$sub" ] || {
      usage >&2
      exit 1
    }
    pos+=("$1")
    ;;
  esac
  shift
done

case $format in
pretty | tsv) ;;
*)
  echo "preflight-checks: --format must be pretty or tsv: '$format'" >&2
  exit 1
  ;;
esac

command -v jq >/dev/null 2>&1 || {
  echo "preflight-checks: jq is required" >&2
  exit 1
}

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "preflight-checks: not inside a git work tree" >&2
  exit 1
}
cd "$(git rev-parse --show-toplevel)" || exit 1

rows=""
emit() { rows+=$(printf '%s\t%s\t%s' "$1" "$2" "$3")$'\n'; }

# A Markdown table padded to its widest cell, so it reads aligned in a terminal
# and renders as a table when pasted into a chat. "|" in a cell is escaped.
table() {
  printf 'name\tstatus\tdetail\n%s' "$rows" | awk -F'\t' '
    { for (i = 1; i <= 3; i++) {
        gsub(/\|/, "\\|", $i); cell[NR, i] = $i
        if (length($i) > w[i]) w[i] = length($i)
      } }
    function row(a, b, c) { printf "| %-*s | %-*s | %-*s |\n", w[1], a, w[2], b, w[3], c }
    function dash(n,   s) { s = ""; while (n-- > 0) s = s "-"; return s }
    END {
      row(cell[1, 1], cell[1, 2], cell[1, 3])
      row(dash(w[1]), dash(w[2]), dash(w[3]))
      for (r = 2; r <= NR; r++) row(cell[r, 1], cell[r, 2], cell[r, 3])
    }'
}

# --- facts ---------------------------------------------------------------

# Cached: a Stop hook calls this after every turn, and the network is the only
# slow part. FETCH_HEAD's mtime is the last fetch.
do_fetch() {
  local head ttl=${KIX_FETCH_TTL:-5}
  [ "$fetch" = 1 ] || {
    echo skipped
    return
  }
  git remote get-url origin >/dev/null 2>&1 || {
    echo skipped
    return
  }
  head=$(git rev-parse --git-path FETCH_HEAD)
  # TTL 0 means always fetch: find's minute rounding can call a FETCH_HEAD
  # written this same second younger than 0 minutes.
  if [ "$ttl" != 0 ] && [ -f "$head" ] &&
    [ -n "$(find "$head" -mmin -"$ttl" 2>/dev/null)" ]; then
    echo fresh
    return
  fi
  # Fail instead of prompting: GIT_TERMINAL_PROMPT covers HTTPS credentials,
  # BatchMode an ssh host key or passphrase. Nobody answers a Stop hook. The
  # env var beats core.sshCommand, so build on whichever the user set.
  export GIT_TERMINAL_PROMPT=0
  GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-$(git config core.sshCommand || echo ssh)} -o BatchMode=yes"
  export GIT_SSH_COMMAND
  if git fetch -q origin 2>/dev/null; then
    echo fetched
  else
    echo failed
  fi
}

# Never assumes main, and never asks the remote (`remote set-head --auto` is a
# network call): origin/HEAD, else the usual names that exist locally.
default_ref() {
  local ref
  ref=$(git symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null) && {
    echo "$ref"
    return
  }
  for ref in origin/main origin/master; do
    git rev-parse -q --verify "refs/remotes/$ref" >/dev/null && {
      echo "$ref"
      return
    }
  done
}

# Committed (vs the merge base) and uncommitted, untracked included. quotePath
# off: git otherwise prints a non-ASCII path quoted and octal-escaped
# ("A\303\247\303\243o.md"), which names no file.
touched_markdown() {
  local from=${1-$base}
  {
    [ -n "$from" ] && git -c core.quotePath=false diff --name-only "$from...HEAD" -- '*.md'
    git -c core.quotePath=false diff --name-only HEAD -- '*.md'
    git -c core.quotePath=false ls-files --others --exclude-standard -- '*.md'
  } 2>/dev/null | sort -u
}

join() { paste -sd, - | sed 's/,/, /g'; }

# --- session store (kxa-102) ----------------------------------------------
# Two append-only JSON-lines files per session, in the git common dir so every
# worktree of the repo shares them. Lines carry their branch and every read
# filters to the current one. Nothing is rewritten: the last line per key wins
# and a finding's later lines merge over its earlier ones.

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

cur_branch() {
  local b
  b=$(git branch --show-current)
  echo "${b:-HEAD}"
}

# Absolute; created on the first write, so a read never leaves a directory.
store_dir() {
  echo "$(git rev-parse --path-format=absolute --git-common-dir)/kix/checks/${session:-unknown}"
}

# Unparseable lines (a write cut short) are skipped, never an error.
store_lines() {
  local f
  f="$(store_dir)/$1"
  [ -f "$f" ] || return 0
  jq -cR 'fromjson? | select(type == "object")' "$f"
}

# One line per finding, merged from all its lines, on this branch.
merged_findings() {
  store_lines findings.jsonl | jq -sc --arg b "$(cur_branch)" '
    map(select(.branch == $b)) | group_by(.id) | map(add)'
}

# Beads repo: .beads/ and a bd on PATH.
beads_repo() { [ -d .beads ] && command -v bd >/dev/null 2>&1; }

# updated_at of a bead, empty when bd cannot show it.
bead_updated() {
  bd show "$1" --json 2>/dev/null |
    jq -r 'if type == "array" then .[0] else . end | .updated_at // empty' 2>/dev/null
}

conversation_checks="conversation-leftovers related-tracker-items unraised-follow-ups post-landing-steps"
is_conversation_check() { case " $conversation_checks " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# The session's transcript: first match of <config>/projects/*/<session>.jsonl,
# empty when there is none or the session is unknown.
transcript_path() {
  local f
  [ -n "${session:-}" ] && [ "$session" != unknown ] || return 0
  for f in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/"$session.jsonl"; do
    [ -f "$f" ] && {
      echo "$f"
      return
    }
  done
}

# {"turn": {uuid, ts}} of the last parseable transcript line with a uuid; {}
# without a transcript or a uuid line. Unparseable lines (Claude Code writing)
# are skipped.
turn_snapshot() {
  local t
  t=$(transcript_path)
  [ -n "$t" ] || {
    echo '{}'
    return
  }
  jq -cR 'fromjson? | select(type == "object" and (.uuid | type) == "string")' "$t" |
    jq -sc 'if length == 0 then {} else last | {turn: {uuid: .uuid, ts: .timestamp}} end'
}

# Timestamp of the first transcript entry after the marker's turn that starts
# a turn (a prompt that is not injected meta text) or answers an
# AskUserQuestion; empty when there is none. "After" is the lines following the
# marker's uuid, else the entries stamped later than its ts.
conversation_since() {
  jq -cR 'fromjson? | select(type == "object")' "$1" | jq -rs --arg uuid "$2" --arg ts "$3" '
    . as $e
    | [ $e[] | select(.type == "assistant") | .message.content? | arrays | .[]
        | select(type == "object" and .type == "tool_use" and .name == "AskUserQuestion") | .id ] as $ask
    | (first(range(0; length) as $i | select($e[$i].uuid == $uuid) | $i) // null) as $at
    | (if $at != null then $e[$at + 1:] else [$e[] | select((.timestamp | type) == "string" and .timestamp > $ts)] end)
    | first(.[]
        | select((.type == "user" or .type == "attachment") and (.timestamp | type) == "string")
        | (.message.content?) as $c
        | select(
            (.type == "attachment" and .attachment.type? == "queued_command")
            or (.type == "user" and .isMeta != true and (($c | type) == "string" or (($c | type) == "array" and ($c[0]?.type? != "tool_result"))))
            or (($c | type) == "array" and $c[0]?.type? == "tool_result" and ($c[0].tool_use_id | IN($ask[]))))
        | .timestamp) // empty'
}

# Extra marker fields as a JSON object: what the check saw, to compare with
# later. Per-check snapshots join here, so the writer below stays the only
# place a marker line is built. $2 is the marker's time, $bead_ts the bead's
# updated_at (read before anything is written).
marker_snapshot() {
  if is_conversation_check "$1"; then
    jq -nc --argjson a "$(marker_snapshot_base "$1" "$2")" --argjson b "$(turn_snapshot)" '$a + $b'
  else
    marker_snapshot_base "$1" "$2"
  fi
}

marker_snapshot_base() {
  local head dirty=true
  case $1 in
  open-checkboxes | diff-review | acceptance-criteria | related-tracker-items | unraised-follow-ups | post-landing-steps)
    head=$(git rev-parse HEAD 2>/dev/null)
    [ -z "$(git status --porcelain)" ] && dirty=false
    jq -nc --arg head "$head" --argjson dirty "$dirty" --arg check "$1" --arg at "$2" \
      --arg bead "$bead" --arg bead_ts "${bead_ts-}" --argjson beads "$(beads_repo && echo true || echo false)" '
      {head: $head, clean: ($dirty | not)}
      + (if $check == "related-tracker-items" and $beads then {bd: $at} else {} end)
      + (if $check == "acceptance-criteria" and $bead != "" then {bead: {id: $bead, updated: $bead_ts}} else {} end)'
    ;;
  *) echo '{}' ;;
  esac
}

# marker_line CHECK AT RUN IDS_JSON
marker_line() {
  jq -nc --arg check "$1" --arg at "$2" --arg run "$3" --arg branch "$(cur_branch)" \
    --argjson ids "$4" --argjson extra "$(marker_snapshot "$1" "$2")" \
    '{check: $check, at: $at, run: $run, branch: $branch, findings: $ids} + $extra'
}

# The latest run anchor on this branch, else empty.
latest_run() {
  store_lines markers.jsonl | jq -rs --arg b "$(cur_branch)" '
    map(select(.branch == $b and has("run") and (has("check") | not))) | last | .run // empty'
}

markable="open-checkboxes diff-review acceptance-criteria conversation-leftovers related-tracker-items unraised-follow-ups post-landing-steps"

die() {
  echo "preflight-checks: $*" >&2
  exit 1
}

sub_start() {
  local t dir
  t=$(now)
  dir=$(store_dir)
  mkdir -p "$dir"
  jq -nc --arg run "$t" --arg branch "$(cur_branch)" '{run: $run, branch: $branch}' >>"$dir/markers.jsonl"
  echo "🛫 preflight check started here · $t"
}

sub_mark() {
  local check=${pos[0]-} input t run dir n all new ids
  case " $markable " in
  *" $check "*) ;;
  *) die "cannot mark '$check'; one of: $markable" ;;
  esac
  if [ "$check" = acceptance-criteria ] && [ -n "$bead" ]; then
    command -v bd >/dev/null 2>&1 || die "bd is required for --bead"
    bead_ts=$(bead_updated "$bead")
    [ -n "$bead_ts" ] || die "bead '$bead' not found"
  fi
  input=$(cat)
  printf '%s' "$input" | jq -e 'type == "array" and all(.[]; type == "object")' >/dev/null 2>&1 ||
    die "stdin must be a JSON array of finding objects"
  t=$(now)
  run=$(latest_run)
  : "${run:=$t}"
  dir=$(store_dir)
  # Ids count over every branch, so two branches never hand out the same id.
  n=$(store_lines findings.jsonl | jq -rs --arg p "$check-" '
    map(.id // empty | select(startswith($p))) | unique | length')
  new=$(printf '%s' "$input" | jq -c --arg check "$check" --arg at "$t" --arg b "$(cur_branch)" --argjson n "$n" '
    to_entries[] | .key as $i | .value as $f |
    {id: "\($check)-\($n + $i + 1)", check: $check, outcome: "open", at: $at, branch: $b} +
    ($f | del(.id, .check, .outcome, .at, .branch))')
  ids=$(printf '%s' "$new" | jq -sc 'map(.id)')
  mkdir -p "$dir"
  [ -z "$new" ] || printf '%s\n' "$new" >>"$dir/findings.jsonl"
  marker_line "$check" "$t" "$run" "$ids" >>"$dir/markers.jsonl"
  printf '%s' "$ids" | jq -r '.[]'
}

sub_resolve() {
  local id=${pos[0]-} outcome=${pos[1]-} rest dir
  rest="${pos[*]:2}"
  merged_findings | jq -e --arg id "$id" 'any(.[]; .id == $id)' >/dev/null ||
    die "unknown finding '$id'"
  dir=$(store_dir)
  case $outcome in
  fixed) rest="" ;;
  deferred) [ -n "$rest" ] || die "deferred needs a ref" ;;
  discarded) [ -n "$rest" ] || die "discarded needs a reason" ;;
  *) die "outcome must be fixed, deferred or discarded: '$outcome'" ;;
  esac
  jq -nc --arg id "$id" --arg outcome "$outcome" --arg at "$(now)" --arg b "$(cur_branch)" \
    --arg rest "$rest" '
    {id: $id, outcome: $outcome, at: $at, branch: $b} +
    (if $outcome == "deferred" then {ref: $rest}
     elif $outcome == "discarded" then {reason: $rest} else {} end)' >>"$dir/findings.jsonl"
}

# Open findings of this branch, ordered by check then number (so -10 follows
# -9), optionally of one check.
open_findings() {
  merged_findings | jq -c --arg c "${1-}" '
    map(select(.outcome == "open" and ($c == "" or .check == $c)))
    | sort_by([.check, (.id | ((capture("-(?<n>[0-9]+)$").n | tonumber)? // 0))])'
}

# --- checkpoints ---------------------------------------------------------

cp_uncommitted_changes() {
  local n
  n=$(git status --porcelain | wc -l | tr -d ' ')
  if [ "$n" = 0 ]; then
    emit uncommitted-changes pass "clean"
  else
    emit uncommitted-changes finding "$n uncommitted path(s)"
  fi
}

cp_unlanded_commits() {
  local n
  [ -n "$base" ] || {
    emit unlanded-commits skip "no default branch"
    return
  }
  n=$(git rev-list --count "$base..HEAD")
  if [ "$n" = 0 ]; then
    emit unlanded-commits pass "all on $base"
  else
    emit unlanded-commits finding "$n commit(s) not on $base"
  fi
}

# Same test as kxa-2b1: when the base is an ancestor of HEAD, there is nothing
# to rebase onto.
cp_behind_default_branch() {
  local n
  [ -n "$base" ] || {
    emit behind-default-branch skip "no default branch"
    return
  }
  if git merge-base --is-ancestor "$base" HEAD; then
    emit behind-default-branch pass "already on $base"
  else
    n=$(git rev-list --count "HEAD..$base")
    emit behind-default-branch finding "$base has $n commit(s) not in HEAD"
  fi
}

# file:line of each unchecked item outside fenced code blocks: a "- [ ]" in a
# ``` or ~~~ block is a template or an example, not pending work. As in
# CommonMark, only a run of the opening fence's character, at least as long and
# with nothing after it, closes the block, so a ~~~ inside ``` stays inside.
unchecked_items() {
  awk -v f="$1" '
    {
      line = $0; sub(/^[[:space:]]*/, "", line)
      if (match(line, /^(```+|~~~+)/)) {
        run = substr(line, 1, RLENGTH); rest = substr(line, RLENGTH + 1)
        if (fence == "") { fence = run; next }
        if (substr(run, 1, 1) == substr(fence, 1, 1) && length(run) >= length(fence) &&
          rest ~ /^[[:space:]]*$/) { fence = ""; next }
      }
    }
    fence == "" && /^[[:space:]]*[-*+] \[ \]/ { print f ":" FNR }
  ' "$1"
}

# --- marker status (kxa-102) ---------------------------------------------

# The latest marker line of a check on this branch, else empty.
marker_of() {
  store_lines markers.jsonl | jq -c --arg b "$(cur_branch)" --arg c "$1" '
    select(.branch == $b and .check == $c)' | tail -n1
}

short_sha() { echo "${1:0:7}"; }

# Where a check's review range starts: its marker head when that is an ancestor
# of HEAD, else the merge base (empty when there is none).
marker_from() {
  local h
  h=$(marker_of "$1" | jq -r '.head // empty')
  if [ -n "$h" ] && git merge-base --is-ancestor "$h" HEAD 2>/dev/null; then
    echo "$h"
  else
    echo "$base"
  fi
}

# Prints "status<TAB>detail" for a markable check: fresh, stale or never. The
# skip cases belong to the callers, who know what there is to check.
marker_status() {
  local check=$1 m reasons=() h n b id upd now_upd tx tu tts since unknown=""
  m=$(marker_of "$check")
  if [ -z "$m" ]; then
    printf 'never\tno marker\n'
    return
  fi
  h=$(printf '%s' "$m" | jq -r '.head // empty')
  if [ -n "$h" ] && [ "$h" != "$(git rev-parse HEAD 2>/dev/null)" ]; then
    if git merge-base --is-ancestor "$h" HEAD 2>/dev/null; then
      reasons+=("new commits since $(short_sha "$h")")
    else
      reasons+=("rebased since $(short_sha "$h")")
    fi
  fi
  # Marked on a dirty tree, or dirty now (only checks that snapshot the tree).
  if printf '%s' "$m" | jq -e 'has("clean") and (.clean | not)' >/dev/null ||
    { printf '%s' "$m" | jq -e 'has("clean")' >/dev/null && [ -n "$(git status --porcelain)" ]; }; then
    reasons+=("dirty tree")
  fi
  b=$(printf '%s' "$m" | jq -r '.bd // empty')
  if [ -n "$b" ] && beads_repo; then
    if n=$(bd list --all --updated-after "$b" --json 2>/dev/null) && n=$(printf '%s' "$n" | jq 'length' 2>/dev/null) && [ -n "$n" ]; then
      [ "$n" -gt 0 ] && reasons+=("$n bd update(s) since $b")
    else
      reasons+=("bd unreadable")
    fi
  fi
  id=$(printf '%s' "$m" | jq -r '.bead.id // empty')
  if [ -n "$id" ] && command -v bd >/dev/null 2>&1; then
    upd=$(printf '%s' "$m" | jq -r '.bead.updated // empty')
    now_upd=$(bead_updated "$id")
    if [ -z "$now_upd" ]; then
      reasons+=("$id unreadable")
    elif [ "$now_upd" != "$upd" ]; then
      reasons+=("$id updated")
    fi
  fi
  if is_conversation_check "$check"; then
    tx=$(transcript_path)
    tu=$(printf '%s' "$m" | jq -r '.turn.uuid // empty')
    tts=$(printf '%s' "$m" | jq -r '.turn.ts // empty')
    if [ -z "$tx" ] || [ -z "$tu$tts" ]; then
      unknown="conversation unknown since $(printf '%s' "$m" | jq -r '.run // .at')"
    else
      since=$(conversation_since "$tx" "$tu" "$tts")
      [ -n "$since" ] && reasons+=("conversation since $since")
    fi
  fi
  if [ ${#reasons[@]} -eq 0 ] && [ -n "$unknown" ]; then
    printf 'unknown\tsince %s\n' "$(printf '%s' "$m" | jq -r '.run // .at')"
  elif [ ${#reasons[@]} -eq 0 ]; then
    printf 'fresh\tno changes since %s\n' "$(printf '%s' "$m" | jq -r .at)"
  else
    [ -n "$unknown" ] && reasons+=("$unknown")
    printf 'stale\t%s\n' "$(printf '%s\n' "${reasons[@]}" | join)"
  fi
}

# emit_marker CHECK [SKIP_REASON]: the check's row from its marker; a skip
# reason applies only without one (fresh wins over skip).
emit_marker() {
  local s d
  IFS=$'\t' read -r s d < <(marker_status "$1")
  if [ "$s" = never ] && [ -n "${2-}" ]; then
    emit "$1" skip "$2"
  else
    emit "$1" "$s" "$d"
  fi
}

cp_open_checkboxes() {
  local s d items from files
  IFS=$'\t' read -r s d < <(marker_status open-checkboxes)
  from=$(marker_from open-checkboxes)
  files=$(touched_markdown "$from")
  items=$(printf '%s\n' "$files" | while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] && unchecked_items "$f"
  done)
  if [ "$s" = never ] && [ -z "$items" ]; then
    emit open-checkboxes skip "no unchecked items"
    return
  fi
  if [ "$s" != fresh ] && [ -n "$items" ]; then
    d="$d — $(printf '%s\n' "$items" | join)"
  fi
  emit open-checkboxes "$s" "$d"
}

cp_diff_review() {
  local n=1
  [ -n "$base" ] && n=$(git rev-list --count "$base..HEAD")
  if [ "$n" = 0 ] && [ -z "$(git status --porcelain)" ]; then
    emit_marker diff-review "no changes"
  else
    emit_marker diff-review
  fi
}

cp_acceptance_criteria() { emit_marker acceptance-criteria; }
cp_conversation_leftovers() { emit_marker conversation-leftovers; }

cp_related_tracker_items() {
  if beads_repo || [ -f Gates/Gates.md ]; then
    emit_marker related-tracker-items
  else
    emit_marker related-tracker-items "no tracker"
  fi
}

cp_unraised_follow_ups() { emit_marker unraised-follow-ups; }
cp_post_landing_steps() { emit_marker post-landing-steps; }

cp_findings_leftovers() {
  local ids
  ids=$(open_findings | jq -r '.[].id' | join)
  if [ -z "$ids" ]; then
    emit findings-leftovers pass "none open"
  else
    emit findings-leftovers finding "$ids"
  fi
}

# --- bead marks (kxa-a9i) -------------------------------------------------

# The beads DB's dolt directory, else nothing (exit 1). It lives in the main
# checkout only — a worktree has no embeddeddolt/ — so it is found through the
# git common dir.
bead_db_dir() {
  local main name
  beads_repo && command -v dolt >/dev/null 2>&1 || return 1
  main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
  name=$(jq -r '.dolt_database // empty' "$main/.beads/metadata.json" 2>/dev/null)
  [ -n "$name" ] && [ -d "$main/.beads/embeddeddolt/$name/.dolt" ] || return 1
  echo "$main/.beads/embeddeddolt/$name"
}

# The DB's current dolt commit (full hash), else nothing.
bead_head() {
  (cd "$1" && dolt sql -r csv -q "select hashof('HEAD') as h" 2>/dev/null) |
    tail -n +2 | grep -E '^[0-9a-v]{32}$'
}

# Where the bead window starts, as {kind, commit, at}: the latest review mark,
# else the session's start mark, else nothing.
bead_window() {
  store_lines bd.jsonl | jq -sc '
    (map(select(.kind == "review")) | last) // (map(select(.kind == "start")) | first) // empty'
}

sub_bd_mark() {
  local kind=${pos[0]-} db h t dir
  case $kind in
  start | review) ;;
  *) die "bd-mark takes start or review: '$kind'" ;;
  esac
  db=$(bead_db_dir) || return 0
  h=$(bead_head "$db")
  [ -n "$h" ] || return 0
  if [ "$kind" = start ] &&
    [ "$(store_lines bd.jsonl | jq -s 'map(select(.kind == "start")) | length')" -gt 0 ]; then
    return 0
  fi
  t=$(now)
  dir=$(store_dir)
  mkdir -p "$dir"
  jq -nc --arg kind "$kind" --arg commit "$h" --arg at "$t" \
    '{kind: $kind, commit: $commit, at: $at}' >>"$dir/bd.jsonl"
  [ "$kind" = start ] || echo "👀 beads reviewed up to $(short_sha "$h") · $t"
}

# --- bead diff (kxa-a9i) --------------------------------------------------

bead_scalar_fields="title status priority issue_type assignee close_reason"
bead_text_fields="description design acceptance_criteria notes"

# A value's lines, nothing for an empty one, always newline-terminated so a
# line diff never prints "\ No newline".
text_lines() { [ -z "$1" ] || printf '%s\n' "$1"; }

# Field $2 of row JSON $1 as text, empty when unset.
row_field() { printf '%s' "$1" | jq -r --arg f "$2" '.[$f] // "" | tostring'; }

# `dolt diff -r json` of the beads DB on stdin, as one git-style block per
# changed issue: its fields, then its deps, labels and comments. Every other
# table (events, config, ...) is bookkeeping and left out.
render_bead_diff() {
  local json ids id row kind from to title f old new first=1
  json=$(cat)
  ids=$(printf '%s' "$json" | jq -r '
    [.tables[]? | .name as $t | select($t | IN("issues", "dependencies", "labels", "comments"))
      | .data_diff[]? | (.from_row, .to_row) | select(. != null and . != {})
      | if $t == "issues" then .id else .issue_id end] | unique | .[]')
  for id in $ids; do
    row=$(printf '%s' "$json" | jq -c --arg id "$id" '
      first(.tables[]? | select(.name == "issues") | .data_diff[]?
        | select((.from_row.id // .to_row.id) == $id)) // null')
    from=$(printf '%s' "$row" | jq -c '.from_row // {}')
    to=$(printf '%s' "$row" | jq -c '.to_row // {}')
    if [ "$row" = null ]; then
      kind=modified
    elif [ "$from" = "{}" ]; then
      kind=created
    elif [ "$to" = "{}" ]; then
      kind=deleted
    else
      kind=modified
    fi
    title=$(row_field "$to" title)
    [ -n "$title" ] || title=$(row_field "$from" title)
    [ -n "$title" ] || [ "$row" != null ] ||
      title=$(bd show "$id" --json 2>/dev/null | jq -r 'if type == "array" then .[0] else . end | .title // empty' 2>/dev/null)
    [ "$first" = 1 ] || echo
    first=0
    echo "@@ $id · $title · $kind @@"
    if [ "$row" != null ]; then
      for f in $bead_scalar_fields; do
        old=$(row_field "$from" "$f")
        new=$(row_field "$to" "$f")
        [ "$old" != "$new" ] || continue
        [ -z "$old" ] || echo "-$f: $old"
        [ -z "$new" ] || echo "+$f: $new"
      done
      for f in $bead_text_fields; do
        old=$(row_field "$from" "$f")
        new=$(row_field "$to" "$f")
        [ "$old" != "$new" ] || continue
        case $kind in
        created) echo "+$f:" && text_lines "$new" | sed 's/^/+  /' ;;
        deleted) echo "-$f:" && text_lines "$old" | sed 's/^/-  /' ;;
        *)
          echo " $f:"
          diff -U2 <(text_lines "$old") <(text_lines "$new") | awk '
            NR <= 2 { next }
            /^@@/ { if (h++) print "   …"; next }
            /^\\/ { next }
            { print substr($0, 1, 1) "  " substr($0, 2) }'
          ;;
        esac
      done
    fi
    printf '%s' "$json" | jq -r --arg id "$id" '
      def edge($t):
        if $t == "dependencies" then "dep: \(.type) \(.depends_on_issue_id // .depends_on_external // "?")"
        elif $t == "labels" then "label: \(.label)"
        else "comment (\(.author)): " + ((.text // "") | split("\n") | .[0] + (if length > 1 then " …" else "" end))
        end;
      . as $all | ("dependencies", "labels", "comments") as $t
      | $all.tables[]? | select(.name == $t) | .data_diff[]?
      | select((.from_row.issue_id // .to_row.issue_id) == $id)
      | (if (.from_row // {}) != {} then "-" + (.from_row | edge($t)) else empty end),
        (if (.to_row // {}) != {} then "+" + (.to_row | edge($t)) else empty end)'
  done
}

sub_diff() {
  if [ -n "$dolt_json" ]; then
    render_bead_diff <"$dolt_json"
    return
  fi
  die "diff without --dolt-json is not built yet"
}

# --- run -----------------------------------------------------------------

case $sub in
start) sub_start; exit $? ;;
mark) sub_mark; exit $? ;;
resolve) sub_resolve; exit $? ;;
findings) open_findings "${pos[0]-}"; exit $? ;;
bd-mark) sub_bd_mark; exit $? ;;
diff) sub_diff; exit $? ;;
esac

fetched=$(do_fetch)
base=$(default_ref)
markdown=$(touched_markdown)

if [ -n "$base" ]; then
  stat=$(git diff --shortstat "$base...HEAD" | sed 's/^ *//')
else
  stat=""
fi

from=$(marker_of diff-review | jq -r '.head // empty')
if [ -n "$from" ] && git merge-base --is-ancestor "$from" HEAD 2>/dev/null; then
  stat=$(git diff --shortstat "$from...HEAD" | sed 's/^ *//')
else
  from=""
fi

emit default fact "${base:--}"
emit from fact "${from:--}"
emit shortstat fact "${stat:-no changes}"
emit markdown fact "$(printf '%s\n' "$markdown" | sed '/^$/d' | join)"
emit fetch fact "$fetched"

cp_uncommitted_changes
cp_unlanded_commits
cp_behind_default_branch
cp_open_checkboxes
cp_diff_review
cp_acceptance_criteria
cp_conversation_leftovers
cp_related_tracker_items
cp_unraised_follow_ups
cp_post_landing_steps
cp_findings_leftovers

case $format in
tsv) printf '%s' "$rows" ;;
pretty) table ;;
esac
