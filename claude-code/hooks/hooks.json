{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__ccd_session_mgmt__set_remote_control",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/allow-remote-control-off.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/title-first-prompt.sh\""
          }
        ]
      }
    ]
  }
}
