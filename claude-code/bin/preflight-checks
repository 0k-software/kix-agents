#!/usr/bin/env bash
# preflight-checks — every deterministic checkpoint of the current branch in one
# call, plus the facts kix:preflight reads before its checks (kxa-cx0). No LLM,
# no network beyond a cached fetch: fast enough for a Stop hook (kxa-v9v).
# Each checkpoint is its own cp_* function so the check library (kxa-102) and
# the gate runner (kxa-efc) can name and reuse them. Every source — the
# transcript, the store, bd, git status — is read once per call (kxa-4z5).

set -uo pipefail

usage() {
  cat <<'EOF'
Usage: preflight-checks [--format pretty|tsv] [--no-fetch] [--session ID]
       preflight-checks start [--bead ID] [--format pretty|tsv] [--no-fetch]
       preflight-checks mark <check> [--bead ID] [--session ID]   (JSON on stdin)
       preflight-checks mark --batch [--bead ID]                  (JSON on stdin)
       preflight-checks resolve <id> fixed [<commit>]|deferred <ref>|discarded <reason...>
       preflight-checks findings [<check>]

Prints one row per fact, then one per checkpoint. --format pretty (the
default) prints them as an aligned Markdown table:

  | name    | status | detail      |
  | ------- | ------ | ----------- |
  | default | fact   | origin/main |

--format tsv prints the same rows as bare tab-separated lines, no header —
for scripts.

Facts (status "fact"):
  default    the default branch's remote ref (origin/main), or "-"
  from       the commit diff-review's marker covers, when it is an ancestor of
             HEAD, else "-"
  shortstat  git diff --shortstat from the merge base to HEAD
  markdown   Markdown files the branch or the dirty tree touches, ", "-joined
  fetch      fresh | fetched | failed | skipped

Checkpoints (status pass | finding | fresh | stale | unknown | never | skip):
  uncommitted-changes    uncommitted changes
  unlanded-commits       commits in HEAD that are not on the default branch
  behind-default-branch  the default branch is not an ancestor of HEAD
  open-checkboxes ...    one row per markable check (see `mark`): fresh when
                         its marker exists and none of its own inputs changed,
                         stale with the reasons, never with no marker, skip
                         when there is nothing to check. Each check watches
                         only what it reads: diff-review every commit and the
                         tree; acceptance-criteria, unraised-follow-ups and
                         post-landing-steps commits other than Fix commits
                         (resolve ... fixed <commit>); the bead for
                         acceptance-criteria and post-landing-steps; new
                         prompts for the conversation checks;
                         related-tracker-items bd updates only;
                         open-checkboxes unchecked "- [ ]" lines in Markdown
                         changed since its marker, listed as file:line.
  findings-leftovers     findings recorded with `mark` and still open
  unreviewed-bead-changes
                         beads changed since the latest bd-mark review, else
                         the session's start mark: pass, finding with their
                         ids, stale when dolt no longer knows the mark,
                         unknown with no mark, skip without a beads DB

Subcommands (the session store, kxa-102; JSON lines under
<git common dir>/kix/checks/<session>/, append-only, read per branch):
  start     the brief: record a run anchor, print it, the rows above, then
            one section per stale, never or unknown check — its instructions
            (skills/preflight/checks/<check>.md) and the data it needs
            (range, bead criteria, candidate findings, bd updates, prompts
            since its marker, its open findings). Marks acceptance-criteria
            itself when there is no bead, or the bead has no design or
            acceptance. Fetches like the default call
  mark      record that <check> ran; stdin is a JSON array of new findings
            (category, summary, optional file, line, short_summary,
            failure_scenario, ref); prints their new ids
  mark --batch
            stdin is {"<check>": [new findings], ..., "resolve": [[id,
            outcome, ref or reason], ...]}: checks everything first, then
            resolves and marks every check named; prints the branch's open
            findings as one JSON array
  resolve   close a finding: fixed [<commit> — the Fix commit, which then
            stales only diff-review], deferred <ref> or discarded <reason...>
  findings  print the open findings of this branch as one JSON array
  bd-mark start|review
            record the beads DB's dolt commit in bd.jsonl (kxa-a9i): start
            once per session (the SessionStart hook), review each time the
            user has seen the bead changes; a no-op without a beads DB
  diff [--from SHA]
            what changed, for the user to review: with --from, the commits
            SHA^..HEAD (inline up to 80 lines, else their stat); then every
            bead change since the bd-mark window as a git-style diff, with a
            warning when other sessions of the repo ran in that window

  --bead ID     the branch's bead, whose updates stale acceptance-criteria and
                post-landing-steps (start: else an id in the branch name)

  --no-fetch    never fetch; the default fetches origin only when the last
                fetch is older than KIX_FETCH_TTL minutes (default 5)
  --session ID  the session whose store is used (default
                $CLAUDE_CODE_SESSION_ID, else "unknown")

Exit 1 outside a git work tree, 0 otherwise — findings are output, not errors.
EOF
}

fetch=1
# The default lives here so it can become configurable later.
format=pretty
session=${CLAUDE_CODE_SESSION_ID-}
bead=""
bead_ts=""
base=""
dolt_json=""
diff_from=""
batch=0
sub=""
pos=()
case ${1-} in
start | mark | resolve | findings | bd-mark | diff)
  sub=$1
  shift
  ;;
esac
while [ $# -gt 0 ]; do
  # After resolve's outcome word everything is the reason or ref, literally.
  if [ "$sub" = resolve ] && [ ${#pos[@]} -ge 2 ]; then
    pos+=("$1")
    shift
    continue
  fi
  case $1 in
  --no-fetch) fetch=0 ;;
  --batch) batch=1 ;;
  --format)
    format=${2-}
    shift
    ;;
  --format=*) format=${1#--format=} ;;
  --session)
    session=${2-}
    shift
    ;;
  --bead)
    bead=${2-}
    shift
    ;;
  --dolt-json)
    dolt_json=${2-}
    shift
    ;;
  --from)
    diff_from=${2-}
    shift
    ;;
  -h | --help) usage && exit 0 ;;
  -*) usage >&2 && exit 1 ;;
  *)
    [ -n "$sub" ] || {
      usage >&2
      exit 1
    }
    pos+=("$1")
    ;;
  esac
  shift
done

case $format in
pretty | tsv) ;;
*)
  echo "preflight-checks: --format must be pretty or tsv: '$format'" >&2
  exit 1
  ;;
esac

command -v jq >/dev/null 2>&1 || {
  echo "preflight-checks: jq is required" >&2
  exit 1
}

# Before the cd below: the check files live next to this script's plugin.
checks_dir="$(cd "$(dirname "$0")/.." && pwd)/skills/preflight/checks"

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "preflight-checks: not inside a git work tree" >&2
  exit 1
}
cd "$(git rev-parse --show-toplevel)" || exit 1

# --- per-call cache --------------------------------------------------------
# One directory per call, so a value read inside a $(...) subshell is still
# read only once: the transcript pass, the store, bd and git status.

cache_dir=$(mktemp -d "${TMPDIR:-/tmp}/preflight-checks.XXXXXX") || exit 1
trap 'rm -rf "$cache_dir"' EXIT

# cached KEY CMD...: CMD's output and exit status, run once per call.
cached() {
  local f="$cache_dir/$1"
  shift
  if [ ! -f "$f.rc" ]; then
    "$@" >"$f"
    echo $? >"$f.rc"
  fi
  cat "$f"
  return "$(cat "$f.rc")"
}

# Drops KEY after a write that changes it.
uncache() { rm -f "$cache_dir/$1" "$cache_dir/$1.rc"; }

rows=""
auto_marked=""
emit() { rows+=$(printf '%s\t%s\t%s' "$1" "$2" "$3")$'\n'; }

# A Markdown table padded to its widest cell, so it reads aligned in a terminal
# and renders as a table when pasted into a chat. "|" in a cell is escaped.
table() {
  printf 'name\tstatus\tdetail\n%s' "$rows" | awk -F'\t' '
    { for (i = 1; i <= 3; i++) {
        gsub(/\|/, "\\|", $i); cell[NR, i] = $i
        if (length($i) > w[i]) w[i] = length($i)
      } }
    function row(a, b, c) { printf "| %-*s | %-*s | %-*s |\n", w[1], a, w[2], b, w[3], c }
    function dash(n,   s) { s = ""; while (n-- > 0) s = s "-"; return s }
    END {
      row(cell[1, 1], cell[1, 2], cell[1, 3])
      row(dash(w[1]), dash(w[2]), dash(w[3]))
      for (r = 2; r <= NR; r++) row(cell[r, 1], cell[r, 2], cell[r, 3])
    }'
}

print_rows() {
  case $format in
  tsv) printf '%s' "$rows" ;;
  pretty) table ;;
  esac
}

# --- facts ---------------------------------------------------------------

# Cached: a Stop hook calls this after every turn, and the network is the only
# slow part. FETCH_HEAD's mtime is the last fetch.
do_fetch() {
  local head ttl=${KIX_FETCH_TTL:-5}
  [ "$fetch" = 1 ] || {
    echo skipped
    return
  }
  git remote get-url origin >/dev/null 2>&1 || {
    echo skipped
    return
  }
  head=$(git rev-parse --git-path FETCH_HEAD)
  # TTL 0 means always fetch: find's minute rounding can call a FETCH_HEAD
  # written this same second younger than 0 minutes.
  if [ "$ttl" != 0 ] && [ -f "$head" ] &&
    [ -n "$(find "$head" -mmin -"$ttl" 2>/dev/null)" ]; then
    echo fresh
    return
  fi
  # Fail instead of prompting: GIT_TERMINAL_PROMPT covers HTTPS credentials,
  # BatchMode an ssh host key or passphrase. Nobody answers a Stop hook. The
  # env var beats core.sshCommand, so build on whichever the user set.
  export GIT_TERMINAL_PROMPT=0
  GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-$(git config core.sshCommand || echo ssh)} -o BatchMode=yes"
  export GIT_SSH_COMMAND
  if git fetch -q origin 2>/dev/null; then
    echo fetched
  else
    echo failed
  fi
}

# Never assumes main, and never asks the remote (`remote set-head --auto` is a
# network call): origin/HEAD, else the usual names that exist locally.
default_ref() {
  local ref
  ref=$(git symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null) && {
    echo "$ref"
    return
  }
  for ref in origin/main origin/master; do
    git rev-parse -q --verify "refs/remotes/$ref" >/dev/null && {
      echo "$ref"
      return
    }
  done
}

# Committed (vs the merge base) and uncommitted, untracked included. quotePath
# off: git otherwise prints a non-ASCII path quoted and octal-escaped
# ("A\303\247\303\243o.md"), which names no file.
touched_markdown() {
  local from=${1-$base}
  {
    [ -n "$from" ] && git -c core.quotePath=false diff --name-only "$from...HEAD" -- '*.md'
    git -c core.quotePath=false diff --name-only HEAD -- '*.md'
    git -c core.quotePath=false ls-files --others --exclude-standard -- '*.md'
  } 2>/dev/null | sort -u
}

join() { paste -sd, - | sed 's/,/, /g'; }

head_sha() { cached head git rev-parse HEAD 2>/dev/null; }
porcelain() { cached porcelain git status --porcelain; }

# --- session store (kxa-102) ----------------------------------------------
# Two append-only JSON-lines files per session, in the git common dir so every
# worktree of the repo shares them. Lines carry their branch and every read
# filters to the current one. Nothing is rewritten: the last line per key wins
# and a finding's later lines merge over its earlier ones.

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

cur_branch() { cached branch branch_name; }
branch_name() {
  local b
  b=$(git branch --show-current)
  echo "${b:-HEAD}"
}

# Absolute; created on the first write, so a read never leaves a directory.
store_dir() {
  echo "$(git rev-parse --path-format=absolute --git-common-dir)/kix/checks/${session:-unknown}"
}

# Unparseable lines (a write cut short) are skipped, never an error.
store_lines() {
  local f
  f="$(store_dir)/$1"
  [ -f "$f" ] || return 0
  jq -cR 'fromjson? | select(type == "object")' "$f"
}

# One line per finding, merged from all its lines, on this branch.
merged_findings() {
  store_lines findings.jsonl | jq -sc --arg b "$(cur_branch)" '
    map(select(.branch == $b)) | group_by(.id) | map(add)'
}

# Beads repo: .beads/ and a bd on PATH.
beads_repo() { [ -d .beads ] && command -v bd >/dev/null 2>&1; }

# The beads DB's dolt directory (bead_db_dir, below), read once.
bead_db() { cached dbdir bead_db_dir; }

# A bead id safe in SQL and in a cache file name.
valid_id() { [[ $1 =~ ^[A-Za-z0-9._-]+$ ]]; }

# updated_at of a bead (2026-10-27T17:56:54Z), empty when it cannot be read:
# one SQL query when dolt can read the beads DB, else bd show.
bead_updated() {
  valid_id "$1" || return 0
  cached "bead-$1" bead_updated_read "$1"
}

bead_updated_read() {
  local db
  if db=$(bead_db); then
    (cd "$db" && dolt sql -r csv -q "select date_format(updated_at, '%Y-%m-%dT%H:%i:%sZ') from issues where id = '$1'" 2>/dev/null) |
      tail -n +2
  else
    bd show "$1" --json 2>/dev/null |
      jq -r 'if type == "array" then .[0] else . end | .updated_at // empty' 2>/dev/null
  fi
}

# The bead as bd show prints it (one object), for the brief; fails when bd
# cannot show it.
bead_json() {
  valid_id "$1" || return 1
  cached "beadjson-$1" bead_json_read "$1"
}

bead_json_read() {
  bd show "$1" --json 2>/dev/null |
    jq -ce 'if type == "array" then .[0] else . end | select(type == "object")' 2>/dev/null
}

# The issues updated after ISO time $1, as a JSON array of {id, status,
# title}; fails when neither dolt nor bd can read them.
bd_updates_since() {
  cached "bdsince-$(printf '%s' "$1" | tr -c 'A-Za-z0-9' _)" bd_updates_read "$1"
}

bd_updates_read() {
  local db out
  if db=$(bead_db); then
    [[ $1 =~ ^[0-9-]+T[0-9:]+Z$ ]] || return 1
    out=$(cd "$db" && dolt sql -r json -q "select id, status, title from issues where updated_at > '$(printf '%s' "$1" | sed 's/T/ /; s/Z$//')' order by updated_at" 2>/dev/null) ||
      return 1
    # No row prints nothing at all.
    [ -n "$out" ] || out='{}'
    printf '%s' "$out" | jq -c '[.rows[]?]'
  else
    out=$(bd list --all --updated-after "$1" --json 2>/dev/null) || return 1
    printf '%s' "$out" | jq -ce 'if type == "array" then map({id, status, title}) else error end' 2>/dev/null
  fi
}

# The bead an id in the branch name names, when bd knows it; else nothing.
branch_bead() {
  local c
  beads_repo || return 0
  for c in $(cur_branch | grep -oE '[a-z][a-z0-9]*-[a-z0-9]+(\.[0-9]+)*' | head -n3); do
    [ -n "$(bead_updated "$c")" ] && {
      echo "$c"
      return
    }
  done
}

# --- what stales each check (kxa-4z5) ---------------------------------------
# commits: any new commit; work-commits: new commits other than Fix commits;
# dirty: an uncommitted change; bead: the branch's bead updated; bd: any bd
# update; conversation: a new prompt; checkboxes: unchecked items in Markdown
# changed since the marker.
triggers() {
  case $1 in
  diff-review) echo "commits dirty" ;;
  acceptance-criteria) echo "work-commits dirty bead" ;;
  open-checkboxes) echo checkboxes ;;
  conversation-leftovers) echo conversation ;;
  related-tracker-items) echo bd ;;
  unraised-follow-ups) echo "work-commits dirty conversation" ;;
  post-landing-steps) echo "work-commits bead conversation" ;;
  esac
}

has_trigger() { case " $(triggers "$1") " in *" $2 "*) return 0 ;; *) return 1 ;; esac; }

watches_head() { has_trigger "$1" commits || has_trigger "$1" work-commits || has_trigger "$1" checkboxes; }

# Full shas of the Fix commits resolve recorded, on any branch, one per line.
fix_commits() { cached fixcommits fix_commits_read; }
fix_commits_read() { store_lines findings.jsonl | jq -r '.commit // empty' | sort -u; }

# True when $1..HEAD holds at least one commit and all are Fix commits.
only_fix_commits() {
  local c fixes list
  fixes=$(fix_commits)
  list=$(git rev-list "$1..HEAD")
  [ -n "$fixes" ] && [ -n "$list" ] || return 1
  for c in $list; do
    printf '%s\n' "$fixes" | grep -qx "$c" || return 1
  done
}

# --- the transcript (one pass) -----------------------------------------------

# The session's transcript: first match of <config>/projects/*/<session>.jsonl,
# empty when there is none or the session is unknown.
transcript() { cached transcript transcript_path; }
transcript_path() {
  local f
  [ -n "${session:-}" ] && [ "$session" != unknown ] || return 0
  for f in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/"$session.jsonl"; do
    [ -f "$f" ] && {
      echo "$f"
      return
    }
  done
}

# The transcript as a TSV index, from one jq pass, read once per call:
#   u <line> <uuid> <ts>       every entry with a uuid
#   p <line> <ts> <excerpt>    every entry that starts a turn: a prompt that is
#                              not injected meta text, or a queued command
# An AskUserQuestion answer that picks offered options starts nothing: after a
# marker it answers preflight's own Decide or Verdict question. One typed
# instead (Other) or with notes is a prompt: it can ask or add anything.
# Unparseable lines (Claude Code writing) are skipped.
tx_index() { cached txindex tx_index_read; }
tx_index_read() {
  local t
  t=$(transcript)
  [ -n "$t" ] || return 0
  jq -rR '
    # The answer is offered labels joined by ", " (multiSelect); a label may
    # hold ", " itself.
    def tiled($ls): . as $s | any($ls[] as $l | $s == $l or (($s | startswith($l + ", ")) and ($s[($l | length + 2):] | tiled($ls))); .);
    fromjson? | select(type == "object") | input_line_number as $n
    | (if (.uuid | type) == "string" then "u\t\($n)\t\(.uuid)\t\(.timestamp // "" | tostring)" else empty end),
      (select((.timestamp | type) == "string") | . as $e | (.message.content?) as $c
        | select((.type == "attachment" and .attachment.type? == "queued_command")
            or (.type == "user" and .isMeta != true
                and (($c | type) == "string" or (($c | type) == "array" and $c[0]?.type? != "tool_result"))))
        | (if $e.type == "attachment" then ($e.attachment.prompt // "" | tostring)
           elif ($c | type) == "string" then $c
           else ([$c[]? | select(.type? == "text") | .text] | first // "") end)
        | gsub("(?s)<system-reminder>.*?</system-reminder>"; "") | gsub("\\s+"; " ") | ltrimstr(" ") | .[0:100]
        | "p\t\($n)\t\($e.timestamp)\t\(.)"),
      (select((.timestamp | type) == "string" and (.toolUseResult.answers? | type) == "object")
        | . as $e | [.toolUseResult.questions[]? | .options[]?.label] as $labels
        | [(.toolUseResult.answers | to_entries[] | .value | tostring
             | select((startswith("[User did not answer") or tiled($labels)) | not)),
           (.toolUseResult.annotations? // {} | to_entries[]? | .value.notes? // empty | tostring)]
        | map(select(. != "")) | select(length > 0) | join(" · ")
        | gsub("\\s+"; " ") | ltrimstr(" ") | .[0:100]
        | "p\t\($n)\t\($e.timestamp)\t\(.)")
  ' "$t" 2>/dev/null
}

# {"turn": {uuid, ts}} of the last transcript entry with a uuid; {} without
# one.
turn_snapshot() {
  local u ts
  IFS=$'\t' read -r u ts < <(tx_index | awk -F'\t' '$1 == "u" { u = $3; t = $4 } END { if (u != "") print u "\t" t }')
  if [ -z "$u" ]; then
    echo '{}'
  else
    jq -nc --arg u "$u" --arg t "$ts" '{turn: {uuid: $u, ts: (if $t == "" then null else $t end)}}'
  fi
}

# "<ts>\t<excerpt>" of every prompt after the marker's turn: the entries after
# the line of its uuid $1, else those stamped later than its ts $2.
prompts_since() {
  tx_index | awk -F'\t' -v u="$1" -v ts="$2" '
    $1 == "u" && u != "" && $3 == u && at == "" { at = $2 }
    $1 == "p" { n++; pl[n] = $2; pt[n] = $3; px[n] = $4 }
    END {
      for (i = 1; i <= n; i++)
        if ((at != "" && pl[i] + 0 > at + 0) || (at == "" && pt[i] > ts)) print pt[i] "\t" px[i]
    }'
}

# Timestamp of the first prompt after the marker's turn; empty when none.
conversation_since() { prompts_since "$1" "$2" | head -n1 | cut -f1; }

# --- markers -------------------------------------------------------------

# Extra marker fields as a JSON object: what the check saw, to compare with
# later — only the inputs its triggers watch. $2 is the marker's time,
# $bead_ts the bead's updated_at (read before anything is written).
marker_snapshot() {
  local dirty=true extra
  [ -z "$(porcelain)" ] && dirty=false
  extra=$(jq -nc --arg head "$(head_sha)" --argjson dirty "$dirty" --arg at "$2" \
    --arg bead "$bead" --arg bead_ts "$bead_ts" \
    --argjson h "$(watches_head "$1" && echo true || echo false)" \
    --argjson bd "$(has_trigger "$1" bd && beads_repo && echo true || echo false)" \
    --argjson b "$(has_trigger "$1" bead && echo true || echo false)" '
    (if $h then {head: $head, clean: ($dirty | not)} else {} end)
    + (if $bd then {bd: $at} else {} end)
    + (if $b and $bead != "" then {bead: {id: $bead, updated: $bead_ts}} else {} end)')
  if has_trigger "$1" conversation; then
    jq -nc --argjson a "$extra" --argjson b "$(turn_snapshot)" '$a + $b'
  else
    echo "$extra"
  fi
}

# marker_line CHECK AT RUN IDS_JSON
marker_line() {
  jq -nc --arg check "$1" --arg at "$2" --arg run "$3" --arg branch "$(cur_branch)" \
    --argjson ids "$4" --argjson extra "$(marker_snapshot "$1" "$2")" \
    '{check: $check, at: $at, run: $run, branch: $branch, findings: $ids} + $extra'
}

# The latest run anchor on this branch, else empty.
latest_run() {
  store_lines markers.jsonl | jq -rs --arg b "$(cur_branch)" '
    map(select(.branch == $b and has("run") and (has("check") | not))) | last | .run // empty'
}

markable="open-checkboxes diff-review acceptance-criteria conversation-leftovers related-tracker-items unraised-follow-ups post-landing-steps"
# The order the brief and the skill take them in.
brief_order="diff-review acceptance-criteria conversation-leftovers open-checkboxes related-tracker-items unraised-follow-ups post-landing-steps"

die() {
  echo "preflight-checks: $*" >&2
  exit 1
}

# Reads the bead's updated_at for the markers; dies when it can't.
read_bead_ts() {
  [ -n "$bead" ] || return 0
  bead_ts=$(bead_updated "$bead")
  [ -n "$bead_ts" ] || die "bead '$bead' not found"
}

# mark_one CHECK: stdin is the JSON array of its new findings (already
# checked); writes them and the marker, prints their ids.
mark_one() {
  local check=$1 input t run dir n new ids
  input=$(cat)
  t=$(now)
  run=$(latest_run)
  : "${run:=$t}"
  dir=$(store_dir)
  # Ids count over every branch, so two branches never hand out the same id.
  n=$(store_lines findings.jsonl | jq -rs --arg p "$check-" '
    map(.id // empty | select(startswith($p))) | unique | length')
  new=$(printf '%s' "$input" | jq -c --arg check "$check" --arg at "$t" --arg b "$(cur_branch)" --argjson n "$n" '
    to_entries[] | .key as $i | .value as $f |
    {id: "\($check)-\($n + $i + 1)", check: $check, outcome: "open", at: $at, branch: $b} +
    ($f | del(.id, .check, .outcome, .at, .branch, .commit))')
  ids=$(printf '%s' "$new" | jq -sc 'map(.id)')
  mkdir -p "$dir"
  [ -z "$new" ] || printf '%s\n' "$new" >>"$dir/findings.jsonl"
  marker_line "$check" "$t" "$run" "$ids" >>"$dir/markers.jsonl"
  uncache markers
  printf '%s' "$ids" | jq -r '.[]'
}

is_markable() { case " $markable " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

sub_mark() {
  local check=${pos[0]-} input
  [ "$batch" = 1 ] && {
    sub_mark_batch
    return
  }
  is_markable "$check" || die "cannot mark '$check'; one of: $markable"
  input=$(cat)
  printf '%s' "$input" | jq -e 'type == "array" and all(.[]; type == "object")' >/dev/null 2>&1 ||
    die "stdin must be a JSON array of finding objects"
  [ "$check" = acceptance-criteria ] || [ "$check" = post-landing-steps ] || bead=""
  read_bead_ts
  printf '%s' "$input" | mark_one "$check"
}

# Checks everything before writing anything: one bad check name, finding or
# resolve leaves the store as it was.
sub_mark_batch() {
  local input err i n id outcome rest lines="" line c
  input=$(cat)
  err=$(printf '%s' "$input" | jq -r --arg m "$markable" '
    if type != "object" then "stdin must be a JSON object"
    else
      ([keys[] | select(. != "resolve" and (. as $k | $m | split(" ") | index([$k]) | not))]
        | if length > 0 then "unknown check(s): " + join(", ") else empty end)
      // ([to_entries[] | select(.key != "resolve" and ((.value | type) != "array" or any(.value[]; type != "object"))) | .key]
        | if length > 0 then "not an array of finding objects: " + join(", ") else empty end)
      // (if has("resolve") and ((.resolve | type) != "array"
              or any(.resolve[]; type != "array" or length < 2 or any(.[]; type != "string")))
          then "resolve must be [[id, outcome, ref or reason], ...]" else empty end)
      // empty
    end' 2>/dev/null) || die "stdin must be a JSON object"
  [ -z "$err" ] || die "$err"
  read_bead_ts
  n=$(printf '%s' "$input" | jq '.resolve // [] | length')
  for ((i = 0; i < n; i++)); do
    id=$(printf '%s' "$input" | jq -r ".resolve[$i][0]")
    outcome=$(printf '%s' "$input" | jq -r ".resolve[$i][1]")
    rest=$(printf '%s' "$input" | jq -r ".resolve[$i][2:] | join(\" \")")
    line=$(resolve_line "$id" "$outcome" "$rest") || exit 1
    lines+="$line"$'\n'
  done
  mkdir -p "$(store_dir)"
  [ -z "$lines" ] || printf '%s' "$lines" >>"$(store_dir)/findings.jsonl"
  for c in $brief_order; do
    printf '%s' "$input" | jq -e --arg c "$c" 'has($c)' >/dev/null || continue
    (
      [ "$c" = acceptance-criteria ] || [ "$c" = post-landing-steps ] || bead=""
      printf '%s' "$input" | jq -c --arg c "$c" '.[$c]' | mark_one "$c" >/dev/null
    )
    uncache markers
  done
  open_findings
}

# The findings.jsonl line that closes finding $1 with outcome $2 and its ref,
# reason or commit $3; dies on a bad one.
resolve_line() {
  local id=$1 outcome=$2 rest=$3 commit=""
  merged_findings | jq -e --arg id "$id" 'any(.[]; .id == $id)' >/dev/null ||
    die "unknown finding '$id'"
  case $outcome in
  fixed)
    if [ -n "$rest" ]; then
      commit=$(git rev-parse -q --verify "$rest^{commit}") || die "fixed: not a commit: '$rest'"
    fi
    rest=""
    ;;
  deferred) [ -n "$rest" ] || die "deferred needs a ref" ;;
  discarded) [ -n "$rest" ] || die "discarded needs a reason" ;;
  *) die "outcome must be fixed, deferred or discarded: '$outcome'" ;;
  esac
  jq -nc --arg id "$id" --arg outcome "$outcome" --arg at "$(now)" --arg b "$(cur_branch)" \
    --arg rest "$rest" --arg commit "$commit" '
    {id: $id, outcome: $outcome, at: $at, branch: $b} +
    (if $outcome == "deferred" then {ref: $rest}
     elif $outcome == "discarded" then {reason: $rest}
     elif $commit != "" then {commit: $commit} else {} end)'
}

sub_resolve() {
  local line dir
  line=$(resolve_line "${pos[0]-}" "${pos[1]-}" "${pos[*]:2}") || exit 1
  dir=$(store_dir)
  mkdir -p "$dir"
  printf '%s\n' "$line" >>"$dir/findings.jsonl"
}

# Open findings of this branch, ordered by check then number (so -10 follows
# -9), optionally of one check.
open_findings() {
  merged_findings | jq -c --arg c "${1-}" '
    map(select(.outcome == "open" and ($c == "" or .check == $c)))
    | sort_by([.check, (.id | ((capture("-(?<n>[0-9]+)$").n | tonumber)? // 0))])'
}

# --- checkpoints ---------------------------------------------------------

cp_uncommitted_changes() {
  local n
  n=$(porcelain | wc -l | tr -d ' ')
  if [ "$n" = 0 ]; then
    emit uncommitted-changes pass "clean"
  else
    emit uncommitted-changes finding "$n uncommitted path(s)"
  fi
}

cp_unlanded_commits() {
  local n
  [ -n "$base" ] || {
    emit unlanded-commits skip "no default branch"
    return
  }
  n=$(git rev-list --count "$base..HEAD")
  if [ "$n" = 0 ]; then
    emit unlanded-commits pass "all on $base"
  else
    emit unlanded-commits finding "$n commit(s) not on $base"
  fi
}

# Same test as kxa-2b1: when the base is an ancestor of HEAD, there is nothing
# to rebase onto.
cp_behind_default_branch() {
  local n
  [ -n "$base" ] || {
    emit behind-default-branch skip "no default branch"
    return
  }
  if git merge-base --is-ancestor "$base" HEAD; then
    emit behind-default-branch pass "already on $base"
  else
    n=$(git rev-list --count "HEAD..$base")
    emit behind-default-branch finding "$base has $n commit(s) not in HEAD"
  fi
}

# "file:line<TAB>text" of each unchecked item outside fenced code blocks: a
# "- [ ]" in a ``` or ~~~ block is a template or an example, not pending work.
# As in CommonMark, only a run of the opening fence's character, at least as
# long and with nothing after it, closes the block, so a ~~~ inside ``` stays
# inside.
unchecked_items() {
  awk -v f="$1" '
    {
      line = $0; sub(/^[[:space:]]*/, "", line)
      if (match(line, /^(```+|~~~+)/)) {
        run = substr(line, 1, RLENGTH); rest = substr(line, RLENGTH + 1)
        if (fence == "") { fence = run; next }
        if (substr(run, 1, 1) == substr(fence, 1, 1) && length(run) >= length(fence) &&
          rest ~ /^[[:space:]]*$/) { fence = ""; next }
      }
    }
    fence == "" && /^[[:space:]]*[-*+] \[ \]/ {
      t = $0; sub(/^[[:space:]]*[-*+] \[ \][[:space:]]*/, "", t); gsub(/\t/, " ", t)
      print f ":" FNR "\t" substr(t, 1, 120)
    }
  ' "$1"
}

# Unchecked items in the Markdown changed since open-checkboxes' marker.
checkbox_items() { cached checkboxes checkbox_items_read; }
checkbox_items_read() {
  local f
  touched_markdown "$(marker_from open-checkboxes)" | while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] && unchecked_items "$f"
  done
  return 0
}

# --- marker status (kxa-102) ---------------------------------------------

# The latest marker line of each check on this branch, one JSON object keyed
# by check, read once (again after a mark).
last_markers() { cached markers last_markers_read; }
last_markers_read() {
  store_lines markers.jsonl | jq -sc --arg b "$(cur_branch)" '
    map(select(.branch == $b and has("check"))) | group_by(.check)
    | map({key: .[0].check, value: last}) | from_entries'
}

# The latest marker line of a check on this branch, else empty.
marker_of() { last_markers | jq -c --arg c "$1" '.[$c] // empty'; }

short_sha() { echo "${1:0:7}"; }

# Where a check's review range starts: its marker head when that is an ancestor
# of HEAD, else the merge base (empty when there is none).
marker_from() {
  local h
  h=$(marker_of "$1" | jq -r '.head // empty')
  if [ -n "$h" ] && git merge-base --is-ancestor "$h" HEAD 2>/dev/null; then
    echo "$h"
  else
    echo "$base"
  fi
}

# Prints "status<TAB>detail" for a markable check: fresh, stale, unknown or
# never, from the triggers it watches. The skip cases belong to the callers,
# who know what there is to check.
marker_status() {
  local check=$1 m reasons=() h clean b id upd tu tts runat at now_upd out n since unknown=""
  m=$(marker_of "$check")
  if [ -z "$m" ]; then
    printf 'never\tno marker\n'
    return
  fi
  IFS=$'\x1f' read -r h clean b id upd tu tts runat at < <(printf '%s' "$m" | jq -r '
    [.head // "", (if has("clean") then (.clean | tostring) else "" end), .bd // "",
     .bead.id // "", .bead.updated // "", .turn.uuid // "", .turn.ts // "",
     .run // .at // "", .at // ""] | join("\u001f")')
  if [ -n "$h" ] && [ "$h" != "$(head_sha)" ] && watches_head "$check"; then
    if git merge-base --is-ancestor "$h" HEAD 2>/dev/null; then
      has_trigger "$check" work-commits && only_fix_commits "$h" ||
        reasons+=("new commits since $(short_sha "$h")")
    else
      reasons+=("rebased since $(short_sha "$h")")
    fi
  fi
  # Marked on a dirty tree, or dirty now (only checks that snapshot the tree).
  if { has_trigger "$check" dirty || has_trigger "$check" checkboxes; } &&
    { [ "$clean" = false ] || { [ -n "$clean" ] && [ -n "$(porcelain)" ]; }; }; then
    reasons+=("dirty tree")
  fi
  if [ -n "$b" ] && has_trigger "$check" bd && beads_repo; then
    if out=$(bd_updates_since "$b") && n=$(printf '%s' "$out" | jq 'length' 2>/dev/null) && [ -n "$n" ]; then
      [ "$n" -gt 0 ] && reasons+=("$n bd update(s) since $b")
    else
      reasons+=("bd unreadable")
    fi
  fi
  if [ -n "$id" ] && has_trigger "$check" bead &&
    { command -v bd >/dev/null 2>&1 || bead_db >/dev/null; }; then
    now_upd=$(bead_updated "$id")
    if [ -z "$now_upd" ]; then
      reasons+=("$id unreadable")
    elif [ "$now_upd" != "$upd" ]; then
      reasons+=("$id updated")
    fi
  fi
  if has_trigger "$check" conversation; then
    if [ -z "$(transcript)" ] || [ -z "$tu$tts" ]; then
      unknown="conversation unknown since $runat"
    else
      since=$(conversation_since "$tu" "$tts")
      [ -n "$since" ] && reasons+=("conversation since $since")
    fi
  fi
  if [ ${#reasons[@]} -eq 0 ] && [ -n "$unknown" ]; then
    printf 'unknown\tsince %s\n' "$runat"
  elif [ ${#reasons[@]} -eq 0 ]; then
    printf 'fresh\tno changes since %s\n' "$at"
  else
    [ -n "$unknown" ] && reasons+=("$unknown")
    printf 'stale\t%s\n' "$(printf '%s\n' "${reasons[@]}" | join)"
  fi
}

# emit_marker CHECK [SKIP_REASON]: the check's row from its marker; a skip
# reason applies only without one (fresh wins over skip).
emit_marker() {
  local s d
  IFS=$'\t' read -r s d < <(marker_status "$1")
  if [ "$s" = never ] && [ -n "${2-}" ]; then
    emit "$1" skip "$2"
  else
    emit "$1" "$s" "$d"
  fi
}

# Stale only while changed Markdown holds unchecked items: an edit that left
# none has nothing to judge.
cp_open_checkboxes() {
  local s d items
  IFS=$'\t' read -r s d < <(marker_status open-checkboxes)
  items=$(checkbox_items | cut -f1)
  if [ "$s" = never ] && [ -z "$items" ]; then
    emit open-checkboxes skip "no unchecked items"
    return
  fi
  if [ "$s" = stale ] && [ -z "$items" ]; then
    s=fresh
    d="no changes since $(marker_of open-checkboxes | jq -r .at)"
  fi
  if [ "$s" != fresh ] && [ -n "$items" ]; then
    d="$d — $(printf '%s\n' "$items" | join)"
  fi
  emit open-checkboxes "$s" "$d"
}

cp_diff_review() {
  local n=1
  [ -n "$base" ] && n=$(git rev-list --count "$base..HEAD")
  if [ "$n" = 0 ] && [ -z "$(porcelain)" ]; then
    emit_marker diff-review "no changes"
  else
    emit_marker diff-review
  fi
}

# The row says why when start marked the check itself.
cp_acceptance_criteria() {
  if [ -n "$auto_marked" ]; then
    emit acceptance-criteria fresh "marked by start: $auto_marked"
  else
    emit_marker acceptance-criteria
  fi
}
cp_conversation_leftovers() { emit_marker conversation-leftovers; }

cp_related_tracker_items() {
  if beads_repo || [ -f Gates/Gates.md ]; then
    emit_marker related-tracker-items
  else
    emit_marker related-tracker-items "no tracker"
  fi
}

cp_unraised_follow_ups() { emit_marker unraised-follow-ups; }
cp_post_landing_steps() { emit_marker post-landing-steps; }

cp_findings_leftovers() {
  local ids
  ids=$(open_findings | jq -r '.[].id' | join)
  if [ -z "$ids" ]; then
    emit findings-leftovers pass "none open"
  else
    emit findings-leftovers finding "$ids"
  fi
}

# --- bead marks (kxa-a9i) -------------------------------------------------

# The beads DB's dolt directory, else nothing (exit 1). It lives in the main
# checkout only — a worktree has no embeddeddolt/ — so it is found through the
# git common dir.
bead_db_dir() {
  local main name
  beads_repo && command -v dolt >/dev/null 2>&1 || return 1
  main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
  name=$(jq -r '.dolt_database // empty' "$main/.beads/metadata.json" 2>/dev/null)
  [ -n "$name" ] && [ -d "$main/.beads/embeddeddolt/$name/.dolt" ] || return 1
  echo "$main/.beads/embeddeddolt/$name"
}

# The DB's current dolt commit (full hash), else nothing.
bead_head() {
  (cd "$1" && dolt sql -r csv -q "select hashof('HEAD') as h" 2>/dev/null) |
    tail -n +2 | grep -E '^[0-9a-v]{32}$'
}

# Where the bead window starts, as {kind, commit, at}: the latest review mark,
# else the session's start mark, else nothing.
bead_window() {
  store_lines bd.jsonl | jq -sc '
    (map(select(.kind == "review")) | last) // (map(select(.kind == "start")) | first) // empty'
}

sub_bd_mark() {
  local kind=${pos[0]-} db h t dir
  case $kind in
  start | review) ;;
  *) die "bd-mark takes start or review: '$kind'" ;;
  esac
  db=$(bead_db_dir) || return 0
  h=$(bead_head "$db")
  [ -n "$h" ] || return 0
  if [ "$kind" = start ] &&
    [ "$(store_lines bd.jsonl | jq -s 'map(select(.kind == "start")) | length')" -gt 0 ]; then
    return 0
  fi
  t=$(now)
  dir=$(store_dir)
  mkdir -p "$dir"
  jq -nc --arg kind "$kind" --arg commit "$h" --arg at "$t" \
    '{kind: $kind, commit: $commit, at: $at}' >>"$dir/bd.jsonl"
  [ "$kind" = start ] || echo "👀 beads reviewed up to $(short_sha "$h") · $t"
}

# --- bead diff (kxa-a9i) --------------------------------------------------

bead_scalar_fields="title status priority issue_type assignee close_reason"
bead_text_fields="description design acceptance_criteria notes"
# Columns bd rewrites on its own (timestamps, hashes, derived flags): never
# named as "other fields changed".
bead_noise_fields="updated_at content_hash is_blocked started_at closed_at"

# A value's lines, nothing for an empty one, always newline-terminated so a
# line diff never prints "\ No newline".
text_lines() { [ -z "$1" ] || printf '%s\n' "$1"; }

# Field $2 of row JSON $1 as text, empty when unset.
row_field() { printf '%s' "$1" | jq -r --arg f "$2" '.[$f] // "" | tostring'; }

# The ids of the issues a `dolt diff -r json` on stdin touches, one per line,
# sorted: issue rows and their deps, labels and comments.
bead_changed_ids() {
  jq -r '
    [.tables[]? | .name as $t | select($t | IN("issues", "dependencies", "labels", "comments"))
      | .data_diff[]? | (.from_row, .to_row) | select(. != null and . != {})
      | if $t == "issues" then .id else .issue_id end] | unique | .[]'
}

# The changes in DB $1 from commit $2 to the working set (which holds bd
# writes not dolt-committed yet), shaped like `dolt diff -r json`:
# {tables: [{name, data_diff: [{from_row, to_row}]}]}. Read through SQL's
# dolt_diff(), not `dolt diff -r json`: the CLI prints a long text column
# stored out of row as a raw {"Buf", "Addr"} blob, SQL as its text. Fails when
# dolt does not know the commit.
bead_dolt_diff() {
  local t out tables=""
  for t in issues dependencies labels comments; do
    out=$(cd "$1" && dolt sql -r json -q "select * from dolt_diff('$2', 'WORKING', '$t')" 2>/dev/null) || return 1
    # No changed row prints nothing at all.
    [ -n "$out" ] || out='{}'
    tables+=$(printf '%s' "$out" | jq -c --arg t "$t" '
      def side($p): with_entries(select(.key | startswith($p)) | .key |= ltrimstr($p))
        | del(.commit, .commit_date);
      {name: $t, data_diff: [.rows[]? | {
        from_row: (if .diff_type == "added" then {} else side("from_") end),
        to_row: (if .diff_type == "removed" then {} else side("to_") end)}]}')
  done
  printf '%s' "$tables" | jq -sc '{tables: .}'
}

# The ids of the issues changed in DB $1 since commit $2, one per line,
# sorted — what bead_dolt_diff | bead_changed_ids gives, in one dolt call
# instead of four: the row runs on every preflight-checks call. Fails when
# dolt does not know the commit.
bead_changed_ids_since() {
  local q="" t col out
  for t in issues dependencies labels comments; do
    col=issue_id
    [ "$t" = issues ] && col=id
    q+="${q:+ union }select coalesce(to_$col, from_$col) as id from dolt_diff('$2', 'WORKING', '$t')"
  done
  out=$(cd "$1" && dolt sql -r csv -q "$q" 2>/dev/null) || return 1
  printf '%s\n' "$out" | tail -n +2 | sed '/^$/d' | sort -u
}

# Ids of the other sessions whose transcript changed after ISO time $1: any
# session of this repo's main checkout or of one of its worktrees, wherever
# they live, by Claude Code's project-dir naming (every character of the path
# but a letter or digit becomes "-").
other_sessions_since() {
  local ref d f
  ref=$(mktemp)
  touch -d "$1" "$ref" 2>/dev/null || {
    rm -f "$ref"
    return 0
  }
  # Each worktree path as git lists it and with symlinks resolved (/var vs
  # /private/var on macOS): either may be the one Claude Code saw.
  git worktree list --porcelain | sed -n 's/^worktree //p' | while read -r d; do
    echo "$d"
    (cd "$d" 2>/dev/null && pwd -P)
  done | sort -u | while read -r d; do
    d="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$(printf '%s' "$d" | sed 's/[^A-Za-z0-9]/-/g')"
    [ -d "$d" ] || continue
    find "$d" -maxdepth 1 -name '*.jsonl' -newer "$ref" 2>/dev/null
  done | while read -r f; do
    f=$(basename "$f" .jsonl)
    [ "$f" = "${session:-}" ] || echo "$f"
  done | sort -u
  rm -f "$ref"
}

# A `dolt diff -r json`-shaped diff of the beads DB on stdin, as one git-style
# block per changed issue: its fields, then its deps, labels and comments.
# Every other table (events, config, ...) is bookkeeping and left out.
render_bead_diff() {
  local json ids id row kind from to title f old new first=1
  json=$(cat)
  ids=$(printf '%s' "$json" | bead_changed_ids)
  for id in $ids; do
    row=$(printf '%s' "$json" | jq -c --arg id "$id" '
      first(.tables[]? | select(.name == "issues") | .data_diff[]?
        | select((.from_row.id // .to_row.id) == $id)) // null')
    from=$(printf '%s' "$row" | jq -c '.from_row // {}')
    to=$(printf '%s' "$row" | jq -c '.to_row // {}')
    if [ "$row" = null ]; then
      kind=modified
    elif [ "$from" = "{}" ]; then
      kind=created
    elif [ "$to" = "{}" ]; then
      kind=deleted
    else
      kind=modified
    fi
    title=$(row_field "$to" title)
    [ -n "$title" ] || title=$(row_field "$from" title)
    [ -n "$title" ] || [ "$row" != null ] ||
      title=$(bd show "$id" --json 2>/dev/null | jq -r 'if type == "array" then .[0] else . end | .title // empty' 2>/dev/null)
    [ "$first" = 1 ] || echo
    first=0
    echo "@@ $id · $title · $kind @@"
    if [ "$row" != null ]; then
      for f in $bead_scalar_fields; do
        old=$(row_field "$from" "$f")
        new=$(row_field "$to" "$f")
        [ "$old" != "$new" ] || continue
        [ -z "$old" ] || echo "-$f: $old"
        [ -z "$new" ] || echo "+$f: $new"
      done
      for f in $bead_text_fields; do
        old=$(row_field "$from" "$f")
        new=$(row_field "$to" "$f")
        [ "$old" != "$new" ] || continue
        case $kind in
        created) echo "+$f:" && text_lines "$new" | sed 's/^/+  /' ;;
        deleted) echo "-$f:" && text_lines "$old" | sed 's/^/-  /' ;;
        *)
          echo " $f:"
          diff -U2 <(text_lines "$old") <(text_lines "$new") | awk '
            NR <= 2 { next }
            /^@@/ { if (h++) print "   …"; next }
            /^\\/ { next }
            { print substr($0, 1, 1) "  " substr($0, 2) }'
          ;;
        esac
      done
      [ "$kind" != modified ] || jq -nr --argjson a "$from" --argjson b "$to" \
        --arg shown "$bead_scalar_fields $bead_text_fields $bead_noise_fields" '
        [($a + $b | keys[]) as $k | select($a[$k] != $b[$k]) | $k] - ($shown | split(" "))
        | select(length > 0) | " other fields changed: " + join(", ")'
    fi
    printf '%s' "$json" | jq -r --arg id "$id" '
      def edge($t):
        if $t == "dependencies" then ["dep: \(.type) \(.depends_on_issue_id // .depends_on_external // "?")"]
        elif $t == "labels" then ["label: \(.label)"]
        else (.author // "?") as $a | ((.text // "") | split("\n")) as $l
          | if ($l | length) <= 1 then ["comment (\($a)): \($l[0] // "")"]
            else ["comment (\($a)):"] + ($l | map("  " + .)) end
        end;
      . as $all | ("dependencies", "labels", "comments") as $t
      | $all.tables[]? | select(.name == $t) | .data_diff[]?
      | select((.from_row.issue_id // .to_row.issue_id) == $id)
      | (if (.from_row // {}) != {} then "-" + (.from_row | edge($t))[] else empty end),
        (if (.to_row // {}) != {} then "+" + (.to_row | edge($t))[] else empty end)'
  done
}

# $2 in a fenced block of language $1, the fence one backtick longer than the
# longest backtick run inside, so a fence in a bead's text or a diffed Markdown
# file can't close it.
fenced() {
  local n f
  n=$(printf '%s' "$2" | grep -oE '`+' | awk '{ if (length > m) m = length } END { print m + 0 }')
  [ "$n" -ge 3 ] || n=2
  f=$(printf '%*s' $((n + 1)) '' | tr ' ' '`')
  printf '%s%s\n%s\n%s\n' "$f" "$1" "$2" "$f"
}

# The code part of `diff`: commits $1^..HEAD inline up to 80 lines, else
# their stat.
code_diff() {
  local base d n
  git rev-parse -q --verify "$1^{commit}" >/dev/null || die "--from: not a commit: '$1'"
  # A root commit has no parent: diff from the empty tree.
  base=$(git rev-parse -q --verify "$1^" 2>/dev/null) || base=$(git hash-object -t tree /dev/null)
  echo "## Code ($(short_sha "$(git rev-parse "$1")")^..$(git rev-parse --short=7 HEAD))"
  echo
  d=$(git diff --no-ext-diff "$base" HEAD)
  n=$(printf '%s\n' "$d" | wc -l | tr -d ' ')
  if [ "$n" -le 80 ]; then
    fenced diff "$d"
  else
    fenced text "$(git diff --stat "$base" HEAD)"
    echo
    echo "Too long to show inline ($n lines)."
  fi
}

# The bead part of `diff`: every bead change since the window's start, and a
# warning when other sessions of this repo ran in the window. Nothing without
# a beads DB.
bead_diff() {
  local db w c at since out others
  db=$(bead_db_dir) || return 0
  w=$(bead_window)
  if [ -z "$w" ]; then
    echo "## Beads"
    echo
    echo "No bead mark for this session — can't tell what changed."
    return 0
  fi
  c=$(printf '%s' "$w" | jq -r .commit)
  at=$(printf '%s' "$w" | jq -r .at)
  case $(printf '%s' "$w" | jq -r .kind) in
  review) since="your last review" ;;
  *) since="session start" ;;
  esac
  echo "## Beads (since $since $(short_sha "$c") · $at)"
  echo
  if ! out=$(bead_dolt_diff "$db" "$c"); then
    echo "Mark $(short_sha "$c") is not in beads history any more."
  else
    out=$(printf '%s' "$out" | render_bead_diff)
    if [ -z "$out" ]; then
      echo "No bead changes."
    else
      fenced diff "$out"
    fi
  fi
  others=$(other_sessions_since "$at" | wc -l | tr -d ' ')
  [ "$others" -eq 0 ] || {
    echo
    echo "⚠️ Other sessions also touched this repo since $at ($others) — some bead changes may be theirs."
  }
}

sub_diff() {
  if [ -n "$dolt_json" ]; then
    render_bead_diff <"$dolt_json"
    return
  fi
  if [ -n "$diff_from" ]; then
    code_diff "$diff_from"
    echo
  fi
  bead_diff
}

cp_unreviewed_bead_changes() {
  local db w c at ids n
  if ! db=$(bead_db_dir); then
    if beads_repo; then
      emit unreviewed-bead-changes skip "beads DB not readable (no dolt CLI, or not embedded mode)"
    else
      emit unreviewed-bead-changes skip "no beads"
    fi
    return
  fi
  w=$(bead_window)
  if [ -z "$w" ]; then
    emit unreviewed-bead-changes unknown "no bead mark"
    return
  fi
  c=$(printf '%s' "$w" | jq -r .commit)
  at=$(printf '%s' "$w" | jq -r .at)
  if ids=$(bead_changed_ids_since "$db" "$c"); then
    ids=$(printf '%s' "$ids" | join)
    if [ -z "$ids" ]; then
      emit unreviewed-bead-changes pass "no bead changes since $(short_sha "$c")"
    else
      n=$(printf '%s\n' "$ids" | tr ',' '\n' | wc -l | tr -d ' ')
      emit unreviewed-bead-changes finding "$n bead(s) changed since $(short_sha "$c"): $ids"
    fi
  else
    ids=$(bd list --all --updated-after "$at" --json 2>/dev/null | jq -r '.[]?.id' 2>/dev/null | join)
    emit unreviewed-bead-changes stale "mark $(short_sha "$c") not in beads history: ${ids:-none updated since $at}"
  fi
}

# --- the brief (kxa-4z5) ---------------------------------------------------

# acceptance-criteria needs no judgement without a bead, or with a bead that
# has neither design nor acceptance criteria: start marks it [] itself.

auto_mark() {
  local info
  [ "$(marker_status acceptance-criteria | cut -f1)" = fresh ] && return 0
  if [ -n "$bead" ]; then
    info=$(bead_json "$bead") || return 0
    printf '%s' "$info" |
      jq -e '(.design // "") == "" and (.acceptance_criteria // "") == ""' >/dev/null || return 0
    bead_ts=$(bead_updated "$bead")
    [ -n "$bead_ts" ] || return 0
    auto_marked="$bead has no design or acceptance criteria"
  else
    auto_marked="no bead for this branch"
  fi
  echo '[]' | mark_one acceptance-criteria >/dev/null
}

# The bead's lines of the brief: acceptance and design for
# acceptance-criteria, notes for post-landing-steps. Long text is cut at 40
# lines, with a pointer to the rest.
brief_bead() {
  local info
  if [ -z "$bead" ]; then
    echo "- bead: none found (start --bead <id> names it)"
    return
  fi
  info=$(bead_json "$bead") || {
    echo "- bead: $bead unreadable"
    return
  }
  printf '%s' "$info" | jq -r --arg c "$1" '
    def text($name; $v):
      if ($v // "") == "" then "- \($name): none"
      else ($v | split("\n")) as $l
        | "- \($name)\(if ($l | length) > 40 then " (first 40 of \($l | length) lines; bd show \(.id) for the rest)" else "" end):",
          ($l[:40][] | "    " + .)
      end;
    "- bead: \(.id) · \(.title)",
    (if $c == "acceptance-criteria" then text("acceptance"; .acceptance_criteria), text("design"; .design)
     else text("notes"; .notes) end)'
}

# Unchecked items as ready findings for mark --batch: the model drops the
# false positives and fills in the fix and the failure.
brief_checkboxes() {
  echo "- candidates for mark --batch (keep the real ones, fill the <…>):"
  checkbox_items | jq -Rr '
    select(length > 0) | split("\t") | (.[0] | capture("^(?<f>.*):(?<l>[0-9]+)$")) as $p
    | {category: "checklist", file: $p.f, line: ($p.l | tonumber),
       summary: "Unchecked: \(.[1] // "") |—| SUGGESTED FIX: <fix> |—|",
       failure_scenario: "<what is lost if it lands now>"}
    | "    " + tojson'
}

# A check's data lines: its range and files, the bead, the candidates, the bd
# updates and the prompts since its marker, and its open findings. Pointers
# and excerpts only, never a whole diff or transcript.
brief_data() {
  local c=$1 s=$2 m from files n b out tu tts runat
  m=$(marker_of "$c")
  if watches_head "$c" && [ "$c" != open-checkboxes ]; then
    from=$(marker_from "$c")
    if [ -n "$from" ]; then
      out=$(git diff --shortstat "$from...HEAD" | sed 's/^ *//')
      echo "- range: $(git rev-parse --short=7 "$from")...$(git rev-parse --short=7 HEAD) · ${out:-no committed changes}"
      files=$(git -c core.quotePath=false diff --name-only "$from...HEAD")
      n=$(printf '%s' "$files" | grep -c .)
      [ "$n" -eq 0 ] || echo "- files: $(printf '%s\n' "$files" | head -n15 | join)$([ "$n" -le 15 ] || echo " (+$((n - 15)) more)")"
    fi
    n=$(porcelain | grep -c .)
    [ "$n" -eq 0 ] || echo "- uncommitted: $n path(s)"
  fi
  case $c in
  acceptance-criteria | post-landing-steps) brief_bead "$c" ;;
  open-checkboxes) brief_checkboxes ;;
  related-tracker-items)
    b=$(printf '%s' "$m" | jq -r '.bd // empty')
    if [ -n "$b" ] && out=$(bd_updates_since "$b"); then
      echo "- bd updates since $b:"
      printf '%s' "$out" | jq -r '.[:20][] | "    \(.id) · \(.status) · \(.title)"'
    else
      echo "- the whole tracker"
    fi
    ;;
  esac
  if has_trigger "$c" conversation; then
    tu=$(printf '%s' "$m" | jq -r '.turn.uuid // empty')
    tts=$(printf '%s' "$m" | jq -r '.turn.ts // empty')
    runat=$(printf '%s' "$m" | jq -r '.run // .at // empty')
    if [ "$s" = never ]; then
      echo "- conversation: the whole session"
    elif [ -z "$(transcript)" ] || [ -z "$tu$tts" ]; then
      echo "- conversation: everything below the 🛫 line of $runat"
    else
      out=$(prompts_since "$tu" "$tts")
      n=$(printf '%s' "$out" | grep -c .)
      if [ "$n" -eq 0 ]; then
        echo "- conversation: no new prompt"
      else
        echo "- prompts since the marker ($n, newest last$([ "$n" -le 10 ] || echo ", last 10")):"
        printf '%s\n' "$out" | tail -n10 | awk -F'\t' '{ print "    " $1 " · " $2 }'
      fi
    fi
  fi
  open_findings "$c" | jq -r '.[] | "- open: \(.id) — \((.short_summary // .summary // "") | .[0:100])"'
}

# One section per check the model has to run: its instructions, then its data.
brief() {
  local c s d
  for c in $brief_order; do
    IFS=$'\t' read -r s d < <(printf '%s' "$rows" | awk -F'\t' -v n="$c" '$1 == n { print $2 "\t" $3 }')
    case $s in stale | never | unknown) ;; *) continue ;; esac
    printf '\n## %s · %s · %s\n\n' "$c" "$s" "$d"
    if [ -f "$checks_dir/$c.md" ]; then
      sed '1{/^# /d;}' "$checks_dir/$c.md" | sed '/./,$!d'
    else
      echo "(no instructions at $checks_dir/$c.md)"
    fi
    echo
    echo "Data:"
    brief_data "$c" "$s"
  done
}

sub_start() {
  local t dir
  fetched=$(do_fetch)
  base=$(default_ref)
  [ -n "$bead" ] || bead=$(branch_bead)
  t=$(now)
  dir=$(store_dir)
  mkdir -p "$dir"
  jq -nc --arg run "$t" --arg branch "$(cur_branch)" '{run: $run, branch: $branch}' >>"$dir/markers.jsonl"
  echo "🛫 preflight check started here · $t"
  auto_mark
  status_rows
  echo
  print_rows
  brief
}

# --- run -----------------------------------------------------------------

status_rows() {
  local markdown stat from
  rows=""
  markdown=$(touched_markdown)
  if [ -n "$base" ]; then
    stat=$(git diff --shortstat "$base...HEAD" | sed 's/^ *//')
  else
    stat=""
  fi
  from=$(marker_of diff-review | jq -r '.head // empty')
  if [ -n "$from" ] && git merge-base --is-ancestor "$from" HEAD 2>/dev/null; then
    stat=$(git diff --shortstat "$from...HEAD" | sed 's/^ *//')
  else
    from=""
  fi

  emit default fact "${base:--}"
  emit from fact "${from:--}"
  emit shortstat fact "${stat:-no changes}"
  emit markdown fact "$(printf '%s\n' "$markdown" | sed '/^$/d' | join)"
  emit fetch fact "$fetched"

  cp_uncommitted_changes
  cp_unlanded_commits
  cp_behind_default_branch
  cp_open_checkboxes
  cp_diff_review
  cp_acceptance_criteria
  cp_conversation_leftovers
  cp_related_tracker_items
  cp_unraised_follow_ups
  cp_post_landing_steps
  cp_findings_leftovers
  cp_unreviewed_bead_changes
}

case $sub in
start) sub_start; exit $? ;;
mark) sub_mark; exit $? ;;
resolve) sub_resolve; exit $? ;;
findings) open_findings "${pos[0]-}"; exit $? ;;
bd-mark) sub_bd_mark; exit $? ;;
diff) sub_diff; exit $? ;;
esac

fetched=$(do_fetch)
base=$(default_ref)
status_rows
print_rows
