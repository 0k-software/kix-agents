#!/usr/bin/env bash
# preflight-checks — every deterministic checkpoint of the current branch in one
# call, plus the facts kix:preflight reads before its checks (kxa-cx0). No LLM,
# no network beyond a cached fetch: fast enough for a Stop hook (kxa-v9v).
# Each checkpoint is its own cp_* function so the check library (kxa-102) and
# the gate runner (kxa-efc) can name and reuse them.

set -uo pipefail

usage() {
  cat <<'EOF'
Usage: preflight-checks [--format pretty|tsv] [--no-fetch] [--session ID]

Prints one row per fact, then one per checkpoint. --format pretty (the
default) prints them as an aligned Markdown table:

  | name    | status | detail      |
  | ------- | ------ | ----------- |
  | default | fact   | origin/main |

--format tsv prints the same rows as bare tab-separated lines, no header —
for scripts.

Facts (status "fact"):
  default    the default branch's remote ref (origin/main), or "-"
  from       newest commit after it whose check mark this session wrote, or "-"
  shortstat  git diff --shortstat from <from> (else the merge base) to HEAD
  markdown   Markdown files the branch or the dirty tree touches, ", "-joined
  fetch      fresh | fetched | failed | skipped

Checkpoints (status pass | finding | stale | skip):
  dirty-tree       uncommitted changes
  unlanded         commits in HEAD that are not on the default branch
  rebase           the default branch is not an ancestor of HEAD
  notes-guard      notes.rewriteRef would carry check marks across a rebase
  marker           HEAD's check mark was written by this session on a clean
                   tree (pass), or not (stale)
  before-shipping  unchecked "- [ ]" lines in touched Markdown, as file:line

  --no-fetch    never fetch; the default fetches origin (and refs/notes/checks)
                only when the last fetch is older than KIX_FETCH_TTL minutes
                (default 5)
  --session ID  the session whose check marks count (default
                $CLAUDE_CODE_SESSION_ID)

Exit 1 outside a git work tree, 0 otherwise — findings are output, not errors.
EOF
}

fetch=1
# The default lives here so it can become configurable later.
format=pretty
session=${CLAUDE_CODE_SESSION_ID-}
while [ $# -gt 0 ]; do
  case $1 in
  --no-fetch) fetch=0 ;;
  --format)
    format=${2-}
    shift
    ;;
  --format=*) format=${1#--format=} ;;
  --session)
    session=${2-}
    shift
    ;;
  -h | --help) usage && exit 0 ;;
  *) usage >&2 && exit 1 ;;
  esac
  shift
done

case $format in
pretty | tsv) ;;
*)
  echo "preflight-checks: --format must be pretty or tsv: '$format'" >&2
  exit 1
  ;;
esac

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "preflight-checks: not inside a git work tree" >&2
  exit 1
}
cd "$(git rev-parse --show-toplevel)" || exit 1

rows=""
emit() { rows+=$(printf '%s\t%s\t%s' "$1" "$2" "$3")$'\n'; }

# A Markdown table padded to its widest cell, so it reads aligned in a terminal
# and renders as a table when pasted into a chat. "|" in a cell is escaped.
table() {
  printf 'name\tstatus\tdetail\n%s' "$rows" | awk -F'\t' '
    { for (i = 1; i <= 3; i++) {
        gsub(/\|/, "\\|", $i); cell[NR, i] = $i
        if (length($i) > w[i]) w[i] = length($i)
      } }
    function row(a, b, c) { printf "| %-*s | %-*s | %-*s |\n", w[1], a, w[2], b, w[3], c }
    function dash(n,   s) { s = ""; while (n-- > 0) s = s "-"; return s }
    END {
      row(cell[1, 1], cell[1, 2], cell[1, 3])
      row(dash(w[1]), dash(w[2]), dash(w[3]))
      for (r = 2; r <= NR; r++) row(cell[r, 1], cell[r, 2], cell[r, 3])
    }'
}

# --- facts ---------------------------------------------------------------

# Cached: a Stop hook calls this after every turn, and the network is the only
# slow part. FETCH_HEAD's mtime is the last fetch.
do_fetch() {
  local head ttl=${KIX_FETCH_TTL:-5}
  [ "$fetch" = 1 ] || {
    echo skipped
    return
  }
  git remote get-url origin >/dev/null 2>&1 || {
    echo skipped
    return
  }
  head=$(git rev-parse --git-path FETCH_HEAD)
  if [ -f "$head" ] && [ -n "$(find "$head" -mmin -"$ttl" 2>/dev/null)" ]; then
    echo fresh
    return
  fi
  # Fail instead of prompting: GIT_TERMINAL_PROMPT covers HTTPS credentials,
  # BatchMode an ssh host key or passphrase. Nobody answers a Stop hook.
  export GIT_TERMINAL_PROMPT=0
  export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes"
  if git fetch -q origin 2>/dev/null; then
    git fetch -q origin refs/notes/checks:refs/notes/checks 2>/dev/null || true
    echo fetched
  else
    echo failed
  fi
}

# Never assumes main, and never asks the remote (`remote set-head --auto` is a
# network call): origin/HEAD, else the usual names that exist locally.
default_ref() {
  local ref
  ref=$(git symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null) && {
    echo "$ref"
    return
  }
  for ref in origin/main origin/master; do
    git rev-parse -q --verify "refs/remotes/$ref" >/dev/null && {
      echo "$ref"
      return
    }
  done
}

# A mark is a refs/notes/checks note with a line "checked <session>"; any line,
# since a union merge of notes stacks two sessions' lines on one commit.
marked_by_session() {
  [ -n "$session" ] &&
    git notes --ref=checks show "$1" 2>/dev/null | grep -qxF "checked $session"
}

# One git call whatever the branch length: each commit prints a "commit <sha>"
# line, then its note's lines, newest first.
newest_marked() {
  [ -n "$base" ] && [ -n "$session" ] || return 0
  git log --notes=checks --format='commit %H%n%N' "$base..HEAD" 2>/dev/null |
    awk -v want="checked $session" '
      /^commit [0-9a-f]+$/ { c = $2; next }
      $0 == want { print c; exit }'
}

# Committed (vs the merge base) and uncommitted, untracked included. quotePath
# off: git otherwise prints a non-ASCII path quoted and octal-escaped
# ("A\303\247\303\243o.md"), which names no file.
touched_markdown() {
  {
    [ -n "$base" ] && git -c core.quotePath=false diff --name-only "$base...HEAD" -- '*.md'
    git -c core.quotePath=false diff --name-only HEAD -- '*.md'
    git -c core.quotePath=false ls-files --others --exclude-standard -- '*.md'
  } 2>/dev/null | sort -u
}

join() { paste -sd, - | sed 's/,/, /g'; }

# --- checkpoints ---------------------------------------------------------

cp_dirty_tree() {
  local n
  n=$(git status --porcelain | wc -l | tr -d ' ')
  if [ "$n" = 0 ]; then
    emit dirty-tree pass "clean"
  else
    emit dirty-tree finding "$n uncommitted path(s)"
  fi
}

cp_unlanded() {
  local n
  [ -n "$base" ] || {
    emit unlanded skip "no default branch"
    return
  }
  n=$(git rev-list --count "$base..HEAD")
  if [ "$n" = 0 ]; then
    emit unlanded pass "all on $base"
  else
    emit unlanded finding "$n commit(s) not on $base"
  fi
}

# Same test as kxa-2b1: when the base is an ancestor of HEAD, there is nothing
# to rebase onto.
cp_rebase() {
  local n
  [ -n "$base" ] || {
    emit rebase skip "no default branch"
    return
  }
  if git merge-base --is-ancestor "$base" HEAD; then
    emit rebase pass "already on $base"
  else
    n=$(git rev-list --count "HEAD..$base")
    emit rebase finding "$base has $n commit(s) not in HEAD"
  fi
}

# notes.rewriteRef set to refs/notes/checks, or a glob matching it, makes check
# marks follow rebased commits and fake the checks.
cp_notes_guard() {
  local line scope value hits=()
  while IFS= read -r line; do
    scope=${line%%$'\t'*}
    value=${line#*$'\t'}
    # Unquoted on the right: the configured value is a glob pattern.
    # shellcheck disable=SC2053
    [[ refs/notes/checks == $value ]] && hits+=("$scope $value")
  done < <(git config --show-scope --get-all notes.rewriteRef 2>/dev/null)
  if [ ${#hits[@]} = 0 ]; then
    emit notes-guard pass "check marks stay behind on rebase"
  else
    emit notes-guard finding "notes.rewriteRef: $(printf '%s\n' "${hits[@]}" | join)"
  fi
}

# kix:preflight's Already checked test: a clean tree whose HEAD this session
# marked is exactly what its last run checked.
cp_marker() {
  if [ -z "$session" ]; then
    emit marker stale "no session id"
  elif [ -n "$(git status --porcelain)" ]; then
    emit marker stale "dirty tree"
  elif marked_by_session HEAD; then
    emit marker pass "HEAD $(git rev-parse --short HEAD) already checked"
  else
    emit marker stale "HEAD $(git rev-parse --short HEAD) not checked by this session"
  fi
}

# file:line of each unchecked item outside fenced code blocks: a "- [ ]" in a
# ``` or ~~~ block is a template or an example, not pending work.
unchecked_items() {
  awk -v f="$1" '
    /^[[:space:]]*(```|~~~)/ { fence = !fence; next }
    !fence && /^[[:space:]]*[-*+] \[ \]/ { print f ":" FNR }
  ' "$1"
}

cp_before_shipping() {
  local items
  items=$(printf '%s\n' "$markdown" | while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] && unchecked_items "$f"
  done)
  if [ -z "$items" ]; then
    emit before-shipping pass "no unchecked items"
  else
    emit before-shipping finding "$(printf '%s\n' "$items" | join)"
  fi
}

# --- run -----------------------------------------------------------------

fetched=$(do_fetch)
base=$(default_ref)
from=$(newest_marked)
markdown=$(touched_markdown)

if [ -n "$from" ]; then
  stat=$(git diff --shortstat "$from..HEAD" | sed 's/^ *//')
elif [ -n "$base" ]; then
  stat=$(git diff --shortstat "$base...HEAD" | sed 's/^ *//')
else
  stat=""
fi

emit default fact "${base:--}"
emit from fact "${from:--}"
emit shortstat fact "${stat:-no changes}"
emit markdown fact "$(printf '%s\n' "$markdown" | sed '/^$/d' | join)"
emit fetch fact "$fetched"

cp_dirty_tree
cp_unlanded
cp_rebase
cp_notes_guard
cp_marker
cp_before_shipping

case $format in
tsv) printf '%s' "$rows" ;;
pretty) table ;;
esac
